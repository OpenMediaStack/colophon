{
  "licenses": [
{{#each licenses}}
    {
      "name": {{{json name}}},
      "text": {{{json text}}},
      "used_by": [{{#each used_by}}{{{json crate.id}}}{{#unless @last}}, {{/unless}}{{/each}}]
    }{{#unless @last}},{{/unless}}
{{/each}}
  ],
  "crates": [
{{#each crates}}
    {
      "id": {{{json package.id}}},
      "name": {{{json package.name}}},
      "version": {{{json package.version}}},
      "license": {{{json license}}},
      "repository": {{{json package.repository}}},
      "authors": {{{json package.authors}}}
    }{{#unless @last}},{{/unless}}
{{/each}}
  ]
}

import { Theme } from "theme.slint";
import { ToolbarButton } from "widgets.slint";

// A bar to click or drag along, from 0 to 1.
component Scrub inherits Rectangle {
    in property <float> value;
    in property <bool> enabled: true;
    in property <string> label;
    callback moved-to(float);

    function at(x: length) -> float {
        return max(0, min(1, x / root.width));
    }

    height: 16px;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: round(root.value * 100);
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    accessible-enabled: root.enabled;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.border-strong;

        Rectangle {
            x: 0;
            width: parent.width * root.value;
            border-radius: 2px;
            background: root.enabled ? Theme.accent : Theme.text-disabled;
        }
    }

    if root.enabled && (touch.has-hover || touch.pressed): Rectangle {
        x: root.width * root.value - self.width / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.text-primary;
    }

    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.moved-to(root.at(self.mouse-x));
            }
        }
        moved => {
            if self.pressed {
                root.moved-to(root.at(self.mouse-x));
            }
        }
    }
}

// The bar under the table: what plays, its controls, where it is and how loud.
export component PlayerBar inherits Rectangle {
    // A sound device exists.
    in property <bool> available;
    in property <bool> has-track;
    in property <bool> playing;
    in property <string> title;
    in property <string> artist;
    // How far the track has played, from 0 to 1, and as times.
    in property <float> progress;
    in property <string> position;
    in property <string> duration;
    // From 0 to 1.
    in property <float> volume;
    callback play-pause;
    callback previous;
    callback next;
    callback seek(float);
    callback set-volume(float);

    height: 56px;
    background: Theme.surface-2;
    accessible-role: groupbox;
    accessible-label: @tr("Player");

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;

        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 6px;

            ToolbarButton {
                y: (parent.height - self.height) / 2;
                icon: @image-url("images/skip-back.svg");
                label: @tr("Previous track");
                enabled: root.has-track;
                clicked => {
                    root.previous();
                }
            }

            Rectangle {
                width: 36px;
                height: 36px;
                y: (parent.height - self.height) / 2;
                border-radius: 18px;
                background: !root.available ? Theme.surface-3 : play-touch.has-hover ? Theme.accent-hover : Theme.accent;
                accessible-role: button;
                accessible-label: root.playing ? @tr("Pause") : @tr("Play");
                accessible-enabled: root.available;
                accessible-action-default => {
                    if root.available {
                        root.play-pause();
                    }
                }

                Image {
                    x: root.playing ? (parent.width - self.width) / 2 : (parent.width - self.width) / 2 + 1px;
                    width: 16px;
                    height: 16px;
                    source: root.playing ? @image-url("images/pause.svg") : @image-url("images/play.svg");
                    colorize: root.available ? Theme.on-accent : Theme.text-disabled;
                }

                play-touch := TouchArea {
                    enabled: root.available;
                    clicked => {
                        root.play-pause();
                    }
                }
            }

            ToolbarButton {
                y: (parent.height - self.height) / 2;
                icon: @image-url("images/skip-forward.svg");
                label: @tr("Next track");
                enabled: root.has-track;
                clicked => {
                    root.next();
                }
            }
        }

        VerticalLayout {
            width: 180px;
            alignment: center;

            Text {
                text: root.title;
                overflow: elide;
                font-weight: 500;
                color: Theme.text-primary;
            }

            Text {
                text: root.artist;
                overflow: elide;
                font-size: 12px;
                color: Theme.text-secondary;
            }
        }

        Text {
            vertical-alignment: center;
            text: root.position;
            font-family: "JetBrains Mono";
            font-size: 12px;
            color: Theme.text-secondary;
        }

        Scrub {
            y: (parent.height - self.height) / 2;
            horizontal-stretch: 1;
            label: @tr("Position");
            value: root.progress;
            enabled: root.has-track;
            moved-to(value) => {
                root.seek(value);
            }
        }

        Text {
            vertical-alignment: center;
            text: root.duration;
            font-family: "JetBrains Mono";
            font-size: 12px;
            color: Theme.text-secondary;
        }

        Image {
            width: 16px;
            y: (parent.height - self.height) / 2;
            source: @image-url("images/volume.svg");
            colorize: Theme.text-secondary;
        }

        Scrub {
            y: (parent.height - self.height) / 2;
            width: 100px;
            label: @tr("Volume");
            value: root.volume;
            enabled: root.available;
            moved-to(value) => {
                root.set-volume(value);
            }
        }
    }
}

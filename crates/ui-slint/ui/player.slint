import { Theme } from "theme.slint";
import { ToolbarButton } from "widgets.slint";

// A bar to click or drag along, from 0 to 1.
component Scrub inherits Rectangle {
    in property <float> value;
    in property <bool> enabled: true;
    in property <string> label;
    callback moved-to(float);

    function at(x: length) -> float {
        return max(0, min(1, x / root.width));
    }

    height: 16px;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: round(root.value * 100);
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    accessible-enabled: root.enabled;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.border-strong;

        Rectangle {
            x: 0;
            width: parent.width * root.value;
            border-radius: 2px;
            background: root.enabled ? Theme.accent : Theme.text-disabled;
        }
    }

    if root.enabled && (touch.has-hover || touch.pressed): Rectangle {
        x: root.width * root.value - self.width / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.text-primary;
    }

    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.moved-to(root.at(self.mouse-x));
            }
        }
        moved => {
            if self.pressed {
                root.moved-to(root.at(self.mouse-x));
            }
        }
    }
}

// The bar under the table: what plays, its controls, where it is and how loud.
export component PlayerBar inherits Rectangle {
    // A sound device exists.
    in property <bool> available;
    in property <bool> has-track;
    in property <bool> playing;
    in property <string> title;
    in property <string> artist;
    // How far the track has played, from 0 to 1, and as times.
    in property <float> progress;
    in property <string> position;
    in property <string> duration;
    // From 0 to 1.
    in property <float> volume;
    // The playing track's waveform: how loud each bar sounds, from 0 to 1, once read; flat until
    // then. The bar asks for as many bars as its width holds.
    in property <[float]> bars;
    in property <bool> has-waveform;
    callback bars-wanted(int);
    callback play-pause;
    callback previous;
    callback next;
    callback seek(float);
    callback set-volume(float);

    // When the centre narrows, the volume goes first, then the waveform shortens. A changed
    // handler rather than a binding, since the bar's width depends on what it holds.
    property <bool> with-volume: true;

    function update-volume-fit() {
        root.with-volume = root.width >= 800px;
    }

    init => {
        root.update-volume-fit();
    }
    changed width => {
        root.update-volume-fit();
    }

    height: 56px;
    background: Theme.surface-2;
    accessible-role: groupbox;
    accessible-label: @tr("Player");

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;

        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 6px;

            ToolbarButton {
                y: (parent.height - self.height) / 2;
                icon: @image-url("images/skip-back.svg");
                label: @tr("Previous track");
                enabled: root.has-track;
                clicked => {
                    root.previous();
                }
            }

            Rectangle {
                width: 36px;
                height: 36px;
                y: (parent.height - self.height) / 2;
                border-radius: 18px;
                background: !root.available ? Theme.surface-3 : play-touch.has-hover ? Theme.accent-hover : Theme.accent;
                accessible-role: button;
                accessible-label: root.playing ? @tr("Pause") : @tr("Play");
                accessible-enabled: root.available;
                accessible-action-default => {
                    if root.available {
                        root.play-pause();
                    }
                }

                Image {
                    x: root.playing ? (parent.width - self.width) / 2 : (parent.width - self.width) / 2 + 1px;
                    width: 16px;
                    height: 16px;
                    source: root.playing ? @image-url("images/pause.svg") : @image-url("images/play.svg");
                    colorize: root.available ? Theme.on-accent : Theme.text-disabled;
                }

                play-touch := TouchArea {
                    enabled: root.available;
                    clicked => {
                        root.play-pause();
                    }
                }
            }

            ToolbarButton {
                y: (parent.height - self.height) / 2;
                icon: @image-url("images/skip-forward.svg");
                label: @tr("Next track");
                enabled: root.has-track;
                clicked => {
                    root.next();
                }
            }
        }

        VerticalLayout {
            width: 140px;
            alignment: center;

            Text {
                text: root.title;
                overflow: elide;
                font-weight: 500;
                color: Theme.text-primary;
            }

            Text {
                text: root.artist;
                overflow: elide;
                font-size: 12px;
                color: Theme.text-secondary;
            }
        }

        Text {
            vertical-alignment: center;
            text: root.position;
            font-family: "JetBrains Mono";
            font-size: 12px;
            color: Theme.text-secondary;
        }

        // The part played in the accent colour, the rest in grey; a click or a drag moves there.
        waveform-area := Rectangle {
            // A bar of 2 points every 3 points: a bar for every second or two of a song.
            property <length> stride: 3px;
            property <length> bar-width: 2px;
            // Where the bars end, and where the played part does, to the point.
            property <length> bars-end: root.bars.length * self.stride - (self.stride - self.bar-width);

            function want-bars() {
                root.bars-wanted(max(1, floor((self.width + self.stride - self.bar-width) / self.stride)));
            }

            horizontal-stretch: 1;
            height: 36px;
            y: (parent.height - self.height) / 2;
            // Bars asked for a wider area wait out of sight until the new ones come.
            clip: true;
            accessible-role: slider;
            accessible-label: @tr("Position");
            accessible-value: round(root.progress * 100);
            accessible-value-minimum: 0;
            accessible-value-maximum: 100;
            accessible-enabled: root.has-track;
            init => {
                self.want-bars();
            }
            changed width => {
                self.want-bars();
            }

            for loudness[index] in root.bars: Rectangle {
                x: index * waveform-area.stride;
                width: waveform-area.bar-width;
                height: max(2px, loudness * waveform-area.height);
                y: (waveform-area.height - self.height) / 2;
                border-radius: 1px;
                background: Theme.border-strong;
            }

            // The same bars in the accent colour, cut where the track has got to.
            Rectangle {
                x: 0;
                width: waveform-area.bars-end * root.progress;
                clip: true;

                for loudness[index] in root.bars: Rectangle {
                    x: index * waveform-area.stride;
                    width: waveform-area.bar-width;
                    height: max(2px, loudness * waveform-area.height);
                    y: (waveform-area.height - self.height) / 2;
                    border-radius: 1px;
                    background: Theme.accent;
                }
            }

            TouchArea {
                function at(x: length) -> float {
                    return max(0, min(1, x / self.width));
                }

                enabled: root.has-track;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        root.seek(self.at(self.mouse-x));
                    }
                }
                moved => {
                    if self.pressed {
                        root.seek(self.at(self.mouse-x));
                    }
                }
            }
        }

        Text {
            vertical-alignment: center;
            text: root.duration;
            font-family: "JetBrains Mono";
            font-size: 12px;
            color: Theme.text-secondary;
        }

        if root.with-volume: Image {
            width: 16px;
            y: (parent.height - self.height) / 2;
            source: @image-url("images/volume.svg");
            colorize: Theme.text-secondary;
        }

        if root.with-volume: Scrub {
            y: (parent.height - self.height) / 2;
            width: 100px;
            label: @tr("Volume");
            value: root.volume;
            enabled: root.available;
            moved-to(value) => {
                root.set-volume(value);
            }
        }
    }
}

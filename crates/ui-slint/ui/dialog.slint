import { Theme } from "theme.slint";
import { Button } from "widgets.slint";

// A modal dialog over the window: a scrim that takes the clicks meant for the window, and a box
// with a title, a message and its buttons in the platform's order. Escape cancels, Return picks
// the primary button.
export component Dialog inherits Rectangle {
    in property <string> title;
    in property <string> message;
    in property <string> primary-text;
    // A choice that loses something, such as not saving; none when empty.
    in property <string> discard-text;
    // Windows puts the primary button first and Cancel last; macOS and Linux end on the primary one.
    in property <bool> windows-order;
    callback primary;
    callback discard;
    callback cancel;

    background: Theme.scrim;

    TouchArea { }

    FocusScope {
        init => {
            self.focus();
        }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel();
                return accept;
            }
            if event.text == Key.Return {
                root.primary();
                return accept;
            }
            reject
        }
    }

    Rectangle {
        width: min(440px, root.width - 32px);
        height: content.preferred-height;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) * 0.4;
        background: Theme.surface-2;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border-subtle;
        drop-shadow-offset-y: 16px;
        drop-shadow-blur: 48px;
        drop-shadow-color: Theme.shadow-dialog;
        accessible-role: groupbox;
        accessible-label: root.title;

        content := VerticalLayout {
            padding: 20px;
            spacing: 10px;

            Text {
                text: root.title;
                wrap: word-wrap;
                font-size: 15px;
                font-weight: 600;
                color: Theme.text-primary;
            }

            Text {
                text: root.message;
                wrap: word-wrap;
                color: Theme.text-secondary;
            }

            HorizontalLayout {
                padding-top: 10px;
                spacing: 8px;

                if !root.windows-order && root.discard-text != "": Button {
                    horizontal-stretch: 0;
                    text: root.discard-text;
                    clicked => {
                        root.discard();
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                if root.windows-order: Button {
                    horizontal-stretch: 0;
                    text: root.primary-text;
                    primary: true;
                    clicked => {
                        root.primary();
                    }
                }

                if root.windows-order && root.discard-text != "": Button {
                    horizontal-stretch: 0;
                    text: root.discard-text;
                    clicked => {
                        root.discard();
                    }
                }

                Button {
                    horizontal-stretch: 0;
                    text: @tr("Cancel");
                    clicked => {
                        root.cancel();
                    }
                }

                if !root.windows-order: Button {
                    horizontal-stretch: 0;
                    text: root.primary-text;
                    primary: true;
                    clicked => {
                        root.primary();
                    }
                }
            }
        }
    }
}

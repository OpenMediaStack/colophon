import { Theme } from "theme.slint";
import { Button } from "widgets.slint";

// A modal dialog over the window: a scrim that takes the clicks meant for the window, and a box
// with a title, a message, what the dialog puts under it, and its buttons in the platform's order.
// Escape cancels, Return picks the primary button unless it destroys something.
export component Dialog inherits Rectangle {
    // No title line when empty: the dialog's content then starts with its own.
    in property <string> title;
    // What assistive technologies call the dialog.
    in property <string> label: root.title;
    in property <string> message;
    in property <string> primary-text;
    // The primary button removes or loses something, in the error colour.
    in property <bool> destructive;
    // No Cancel button when empty: Escape still cancels.
    in property <string> cancel-text: @tr("Cancel");
    // Another choice, apart from the others, such as not saving; none when empty.
    in property <string> discard-text;
    // Windows puts the primary button first and Cancel last; macOS and Linux end on the primary one.
    in property <bool> windows-order;
    in property <length> box-width: 440px;
    callback primary;
    callback discard;
    callback cancel;

    background: Theme.scrim;

    TouchArea { }

    FocusScope {
        init => {
            self.focus();
        }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel();
                return accept;
            }
            if event.text == Key.Return && !root.destructive {
                root.primary();
                return accept;
            }
            reject
        }
    }

    Rectangle {
        width: min(root.box-width, root.width - 32px);
        height: content.preferred-height;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) * 0.4;
        background: Theme.surface-2;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border-subtle;
        drop-shadow-offset-y: 16px;
        drop-shadow-blur: 48px;
        drop-shadow-color: Theme.shadow-dialog;
        accessible-role: groupbox;
        accessible-label: root.label;

        content := VerticalLayout {
            padding: 20px;
            spacing: 10px;

            if root.title != "": Text {
                text: root.title;
                wrap: word-wrap;
                font-size: 15px;
                font-weight: 600;
                color: Theme.text-primary;
            }

            if root.message != "": Text {
                text: root.message;
                wrap: word-wrap;
                color: Theme.text-secondary;
            }

            @children

            HorizontalLayout {
                padding-top: 10px;
                spacing: 8px;

                if !root.windows-order && root.discard-text != "": Button {
                    horizontal-stretch: 0;
                    text: root.discard-text;
                    clicked => {
                        root.discard();
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                if root.windows-order: Button {
                    horizontal-stretch: 0;
                    text: root.primary-text;
                    primary: true;
                    destructive: root.destructive;
                    clicked => {
                        root.primary();
                    }
                }

                if root.windows-order && root.discard-text != "": Button {
                    horizontal-stretch: 0;
                    text: root.discard-text;
                    clicked => {
                        root.discard();
                    }
                }

                if root.cancel-text != "": Button {
                    horizontal-stretch: 0;
                    text: root.cancel-text;
                    clicked => {
                        root.cancel();
                    }
                }

                if !root.windows-order: Button {
                    horizontal-stretch: 0;
                    text: root.primary-text;
                    primary: true;
                    destructive: root.destructive;
                    clicked => {
                        root.primary();
                    }
                }
            }
        }
    }
}

import { Theme } from "theme.slint";
import { SmallButton } from "widgets.slint";

export enum ScanState { idle, scanning, completed, stopped, failed }

// The bottom bar: what the library holds, the reading of a folder, and the files it could not read.
export component StatusBar inherits Rectangle {
    in property <ScanState> scan-state;
    in property <int> track-count;
    in property <int> unreadable-count;
    in property <int> selected-count;
    in property <int> modified-count;
    in property <bool> saving;
    in property <int> save-done;
    in property <int> save-total;
    in property <int> save-failures;
    in property <string> folder;
    // Developer mode is on: its marker makes it impossible to forget.
    in property <bool> developer-mode;
    callback stop-scan;

    height: 24px;
    background: Theme.surface-0;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 16px;

        Text {
            vertical-alignment: center;
            font-size: 12px;
            color: Theme.text-secondary;
            text: (root.scan-state == ScanState.idle ? @tr("No folder open")
                : root.scan-state == ScanState.scanning ? @tr("Reading… {n} track found" | "Reading… {n} tracks found" % root.track-count)
                : root.scan-state == ScanState.stopped ? @tr("Reading stopped, {n} track" | "Reading stopped, {n} tracks" % root.track-count)
                : root.scan-state == ScanState.failed ? @tr("Could not read this folder")
                : @tr("{n} track" | "{n} tracks" % root.track-count))
                + (root.selected-count > 0 ? " · " + @tr("{n} selected" | "{n} selected" % root.selected-count) : "");
        }

        if root.scan-state == ScanState.scanning: VerticalLayout {
            alignment: center;

            SmallButton {
                text: @tr("Stop");
                clicked => {
                    root.stop-scan();
                }
            }
        }

        if root.saving: Text {
            vertical-alignment: center;
            font-size: 12px;
            color: Theme.text-secondary;
            text: @tr("Saving… {0} of {1}", root.save-done, root.save-total);
        }

        if root.save-failures > 0: Text {
            vertical-alignment: center;
            font-size: 12px;
            color: Theme.error;
            text: @tr("{n} file could not be saved" | "{n} files could not be saved" % root.save-failures);
        }

        if root.modified-count > 0 && !root.saving: Text {
            vertical-alignment: center;
            font-size: 12px;
            color: Theme.accent-text;
            text: @tr("{n} file with unsaved changes" | "{n} files with unsaved changes" % root.modified-count);
        }

        if root.unreadable-count > 0: Text {
            vertical-alignment: center;
            font-size: 12px;
            color: Theme.error;
            text: @tr("{n} file could not be read" | "{n} files could not be read" % root.unreadable-count);
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        if root.folder != "": Text {
            vertical-alignment: center;
            font-family: "JetBrains Mono";
            font-size: 12px;
            color: Theme.text-secondary;
            text: root.folder;
        }

        if root.developer-mode: Rectangle {
            width: marker.preferred-width + 12px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            border-width: 1px;
            border-color: Theme.border-strong;
            accessible-role: text;
            accessible-label: marker.text;

            marker := Text {
                text: @tr("Developer mode");
                font-family: "JetBrains Mono";
                font-size: 11px;
                color: Theme.text-tertiary;
            }
        }
    }
}

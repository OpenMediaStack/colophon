import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Medium.ttf";
import { Theme } from "theme.slint";
import { Region, ToolbarButton } from "widgets.slint";
import { EmptyState } from "empty-state.slint";
import { ScanState, StatusBar } from "status-bar.slint";
import { TrackColumns, TrackRow, TrackStatus, TrackTable } from "track-table.slint";

export { Theme, ScanState, TrackColumns, TrackRow, TrackStatus }

// The user actions the window can ask the engine to run.
export enum Command { open-folder, stop-scan, toggle-sidebar, toggle-inspector }

export component AppWindow inherits Window {
    in property <bool> sidebar-visible: true;
    in property <bool> inspector-visible: true;
    in property <bool> folder-open;
    in property <string> folder;
    in property <ScanState> scan-state;
    in property <int> track-count;
    in property <int> unreadable-count;
    in property <[TrackRow]> tracks;
    in property <TrackColumns> columns: {
        artist: true,
        album: true,
        year: true,
        genre: true,
        time: true,
        bitrate: true,
        tags: false,
        file: false,
        folder: false,
    };
    // How shortcuts are written: Command O on macOS, Ctrl+O elsewhere. Tests set it so that their
    // reference captures do not depend on the machine.
    in property <bool> mac-shortcuts: Platform.os == OperatingSystemType.macos;
    callback run(Command);

    property <length> sidebar-width: 220px;
    property <length> inspector-width: 320px;
    property <length> centre-min-width: 560px;
    property <bool> sidebar-fits: true;
    property <bool> sidebar-shown: root.sidebar-visible && root.sidebar-fits;

    // The sidebar gives way when the centre column would get too narrow. This is a changed
    // handler rather than a binding because the window's width itself depends on the sidebar.
    function update-sidebar-fit() {
        root.sidebar-fits = root.width - root.sidebar-width - (root.inspector-visible ? root.inspector-width : 0px) >= root.centre-min-width;
    }

    init => {
        root.update-sidebar-fit();
    }
    changed width => {
        root.update-sidebar-fit();
    }
    changed inspector-visible => {
        root.update-sidebar-fit();
    }

    title: "Colophon";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 600px;
    background: Theme.border-subtle;
    default-font-family: "Inter";
    default-font-size: 13px;

    // Slint calls the Command key Control on macOS: the shortcuts read Command O, and Option Command S
    // and I as in the Finder, there.
    MenuBar {
        Menu {
            title: @tr("File");

            MenuItem {
                title: @tr("Open Folder…");
                shortcut: @keys(Control + O);
                activated => {
                    root.run(Command.open-folder);
                }
            }
        }

        Menu {
            title: @tr("View");

            MenuItem {
                title: root.sidebar-visible ? @tr("Hide Sidebar") : @tr("Show Sidebar");
                shortcut: @keys(Control + Alt + S);
                activated => {
                    root.run(Command.toggle-sidebar);
                }
            }

            MenuItem {
                title: root.inspector-visible ? @tr("Hide Inspector") : @tr("Show Inspector");
                shortcut: @keys(Control + Alt + I);
                activated => {
                    root.run(Command.toggle-inspector);
                }
            }
        }
    }

    VerticalLayout {
        spacing: 1px;

        Rectangle {
            height: 40px;
            background: Theme.surface-2;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 4px;

                ToolbarButton {
                    icon: @image-url("images/folder.svg");
                    label: @tr("Open folder");
                    clicked => {
                        root.run(Command.open-folder);
                    }
                }

                Text {
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    text: @tr("Toolbar");
                    font-size: 12px;
                    color: Theme.text-tertiary;
                }

                ToolbarButton {
                    icon: @image-url("images/panel-left.svg");
                    label: @tr("Toggle sidebar");
                    checkable: true;
                    checked: root.sidebar-visible;
                    clicked => {
                        root.run(Command.toggle-sidebar);
                    }
                }

                ToolbarButton {
                    icon: @image-url("images/panel-right.svg");
                    label: @tr("Toggle inspector");
                    checkable: true;
                    checked: root.inspector-visible;
                    clicked => {
                        root.run(Command.toggle-inspector);
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 1px;

            if root.sidebar-shown: Region {
                width: root.sidebar-width;
                label: @tr("Sidebar");
                background: Theme.surface-0;
            }

            VerticalLayout {
                spacing: 1px;

                if !root.folder-open: EmptyState {
                    open-shortcut: root.mac-shortcuts ? "⌘O" : "Ctrl+O";
                    open-folder => {
                        root.run(Command.open-folder);
                    }
                }

                if root.folder-open: TrackTable {
                    rows: root.tracks;
                    columns: root.columns;
                }

                Region {
                    height: 56px;
                    label: @tr("Player");
                    background: Theme.surface-2;
                }
            }

            if root.inspector-visible: Region {
                width: root.inspector-width;
                label: @tr("Inspector");
                background: Theme.surface-1;
            }
        }

        StatusBar {
            scan-state: root.scan-state;
            track-count: root.track-count;
            unreadable-count: root.unreadable-count;
            folder: root.folder;
            stop-scan => {
                root.run(Command.stop-scan);
            }
        }
    }
}

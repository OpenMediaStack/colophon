import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Medium.ttf";
import { Theme } from "theme.slint";
import { Region, ToolbarButton } from "widgets.slint";
import { FilterField, SaveButton } from "toolbar.slint";
import { PlayerBar } from "player.slint";
import { EmptyState } from "empty-state.slint";
import { ScanState, StatusBar } from "status-bar.slint";
import { SortColumn, TrackColumnWidths, TrackColumn, TrackColumns, TrackRow, TrackStatus, TrackTable } from "track-table.slint";
import { UnsavedChanges, UnsavedChoice } from "unsaved-changes.slint";
import { ConfirmTagRemoval, RemovedTag, TagRemoval } from "tag-removal.slint";
import { Sidebar, SidebarItem, SourceKind } from "sidebar.slint";
import { BitrateMode, ByteSize, CoverState, Id3v1Losses, Kilohertz, TrackSpectrum, InspectedTracks, Inspector, InspectorField, InspectorState, ReadProblem, SizeUnit, UnreadableFile } from "inspector.slint";
import { TagEditing, TagField } from "tag-editing.slint";
import { Id3v1Policy, Settings } from "settings.slint";
import { CommandPalette, PaletteAction, PaletteEntry, PaletteMatch } from "palette.slint";

export { Theme, Id3v1Policy, PaletteAction, PaletteEntry, PaletteMatch, CoverState, Kilohertz, TrackSpectrum, SidebarItem, SourceKind, SortColumn, UnsavedChoice, RemovedTag, TagRemoval, ScanState, TrackColumnWidths, TrackColumn, TrackColumns, TrackRow, TrackStatus, BitrateMode, ByteSize, Id3v1Losses, InspectedTracks, TagEditing, TagField, InspectorField, InspectorState, ReadProblem, SizeUnit, UnreadableFile }

// The user actions the window can ask the engine to run.
export enum Command {
    open-folder,
    open-files,
    stop-scan,
    toggle-sidebar,
    toggle-inspector,
    toggle-developer-mode,
    reset-columns,
    select-all,
    select-previous,
    select-next,
    extend-selection-up,
    extend-selection-down,
    save,
    undo,
    redo,
    revert,
    number-tracks,
    select-album,
    play-pause,
    play-next,
    play-previous,
}

export component AppWindow inherits Window {
    in property <bool> sidebar-visible: true;
    in property <bool> inspector-visible: true;
    in property <bool> developer-mode;
    // Something was opened: a folder, or files.
    in property <bool> folder-open;
    in property <ScanState> scan-state;
    in property <int> track-count;
    in property <int> unreadable-count;
    in property <[TrackRow]> tracks;
    in property <TrackColumns> columns: {
        artist: true,
        album: true,
        year: true,
        genre: true,
        time: true,
        bitrate: false,
        tags: false,
        file: false,
        folder: false,
    };
    // How shortcuts are written: Command O on macOS, Ctrl+O elsewhere. Tests set it so that their
    // reference captures do not depend on the machine.
    in property <bool> mac-shortcuts: Platform.os == OperatingSystemType.macos;
    callback run(Command);
    // Set once the user has resized a column.
    in property <bool> columns-sized;
    in property <TrackColumnWidths> column-widths;
    // The longest value of each column, to fit a column to its content.
    in property <TrackRow> longest;
    in property <int> focused-row: -1;
    in property <int> selected-count;
    in property <int> modified-count;
    in property <bool> can-undo;
    in property <bool> can-redo;
    // A save runs: how far it has got, and the files the last one could not write.
    in property <bool> saving;
    in property <int> save-done;
    in property <int> save-total;
    in property <int> save-failures;
    in property <InspectorState> inspector-state;
    in property <InspectedTracks> inspected-tracks;
    in property <bool> has-spectrum;
    in property <TrackSpectrum> spectrum;
    in property <UnreadableFile> unreadable-file;
    // Set while the window asks what to do with the pending changes before quitting.
    in property <bool> asking-to-save;
    // The titles of the first modified tracks, for the question.
    in property <[string]> unsaved-titles;
    callback unsaved-changes(UnsavedChoice);
    // Set while the window asks before removing a tag from files.
    in property <bool> confirming-removal;
    in property <TagRemoval> removal;
    callback removal-answered(bool);
    // A dialog is up: the menu items that act on the library wait for it.
    property <bool> modal: root.asking-to-save || root.confirming-removal || root.settings-open || root.palette-open;
    // The settings: the ID3v2 version written by default is 2.3 rather than 2.4, and the files
    // that get an ID3v1 tag.
    in-out property <bool> settings-open;
    in property <bool> id3v2-3;
    in property <Id3v1Policy> id3v1-policy;
    callback choose-id3v2-3(bool);
    callback choose-id3v1-policy(Id3v1Policy);
    property <bool> linux: Platform.os == OperatingSystemType.linux;
    // The command palette, and what the bridge does with it: keep the entries that hold what is
    // typed, and run the one chosen.
    in-out property <bool> palette-open;
    pure callback filter-palette([PaletteEntry], string) -> [PaletteMatch];
    callback palette-chosen(PaletteAction);
    // Every command, by name, with whether it can run now.
    property <[PaletteEntry]> palette-entries: [
        { label: @tr("Open Folder…"), category: @tr("File"), enabled: true, action: PaletteAction.open-folder },
        { label: @tr("Open Files…"), category: @tr("File"), enabled: true, action: PaletteAction.open-files },
        { label: @tr("Save"), category: @tr("File"), enabled: root.modified-count > 0 && !root.saving, action: PaletteAction.save },
        { label: root.linux ? @tr("Preferences…") : root.windows-buttons ? @tr("Options…") : @tr("Settings…"), category: @tr("File"), enabled: true, action: PaletteAction.settings },
        { label: @tr("Undo"), category: @tr("Edit"), enabled: root.can-undo, action: PaletteAction.undo },
        { label: @tr("Redo"), category: @tr("Edit"), enabled: root.can-redo, action: PaletteAction.redo },
        { label: @tr("Find"), category: @tr("Edit"), enabled: root.folder-open, action: PaletteAction.find },
        { label: @tr("Select All"), category: @tr("Edit"), enabled: root.folder-open, action: PaletteAction.select-all },
        { label: @tr("Select Album"), category: @tr("Edit"), enabled: root.selected-count > 0, action: PaletteAction.select-album },
        { label: @tr("Number Tracks"), category: @tr("Edit"), enabled: root.selected-count > 0, action: PaletteAction.number-tracks },
        { label: @tr("Revert"), category: @tr("Edit"), enabled: root.inspected-tracks.has-changes, action: PaletteAction.revert },
        { label: root.player-playing ? @tr("Pause") : @tr("Play"), category: @tr("Controls"), enabled: root.player-available && root.folder-open, action: PaletteAction.play-pause },
        { label: @tr("Next Track"), category: @tr("Controls"), enabled: root.player-has-track, action: PaletteAction.next-track },
        { label: @tr("Previous Track"), category: @tr("Controls"), enabled: root.player-has-track, action: PaletteAction.previous-track },
        { label: @tr("Write ID3v2.4 to the selected files"), category: @tr("Tags"), enabled: root.developer-mode && root.selected-count > 0, action: PaletteAction.write-id3v2-4 },
        { label: @tr("Write ID3v2.3 to the selected files"), category: @tr("Tags"), enabled: root.developer-mode && root.selected-count > 0, action: PaletteAction.write-id3v2-3 },
        { label: @tr("Write ID3v2.2 to the selected files"), category: @tr("Tags"), enabled: root.developer-mode && root.selected-count > 0, action: PaletteAction.write-id3v2-2 },
        { label: @tr("Remove ID3v2 from the selected files…"), category: @tr("Tags"), enabled: root.developer-mode && root.selected-count > 0, action: PaletteAction.remove-id3v2 },
        { label: @tr("Write ID3v1.1 to the selected files"), category: @tr("Tags"), enabled: root.developer-mode && root.selected-count > 0, action: PaletteAction.write-id3v1-1 },
        { label: @tr("Write ID3v1.0 to the selected files"), category: @tr("Tags"), enabled: root.developer-mode && root.selected-count > 0, action: PaletteAction.write-id3v1-0 },
        { label: @tr("Remove ID3v1 from the selected files…"), category: @tr("Tags"), enabled: root.developer-mode && root.selected-count > 0, action: PaletteAction.remove-id3v1 },
        { label: root.sidebar-visible ? @tr("Hide Sidebar") : @tr("Show Sidebar"), category: @tr("View"), enabled: true, action: PaletteAction.toggle-sidebar },
        { label: root.inspector-visible ? @tr("Hide Inspector") : @tr("Show Inspector"), category: @tr("View"), enabled: true, action: PaletteAction.toggle-inspector },
        { label: root.columns.artist ? @tr("Hide the Artist column") : @tr("Show the Artist column"), category: @tr("View"), enabled: true, action: PaletteAction.toggle-artist },
        { label: root.columns.album ? @tr("Hide the Album column") : @tr("Show the Album column"), category: @tr("View"), enabled: true, action: PaletteAction.toggle-album },
        { label: root.columns.year ? @tr("Hide the Year column") : @tr("Show the Year column"), category: @tr("View"), enabled: true, action: PaletteAction.toggle-year },
        { label: root.columns.genre ? @tr("Hide the Genre column") : @tr("Show the Genre column"), category: @tr("View"), enabled: true, action: PaletteAction.toggle-genre },
        { label: root.columns.time ? @tr("Hide the Time column") : @tr("Show the Time column"), category: @tr("View"), enabled: true, action: PaletteAction.toggle-time },
        { label: root.columns.bitrate ? @tr("Hide the Bitrate column") : @tr("Show the Bitrate column"), category: @tr("View"), enabled: true, action: PaletteAction.toggle-bitrate },
        { label: root.columns.tags ? @tr("Hide the Tags column (ID3 versions)") : @tr("Show the Tags column (ID3 versions)"), category: @tr("View"), enabled: true, action: PaletteAction.toggle-tags },
        { label: root.columns.file ? @tr("Hide the File column") : @tr("Show the File column"), category: @tr("View"), enabled: true, action: PaletteAction.toggle-file },
        { label: root.columns.folder ? @tr("Hide the Folder column") : @tr("Show the Folder column"), category: @tr("View"), enabled: true, action: PaletteAction.toggle-folder },
        { label: @tr("Reset to default columns"), category: @tr("View"), enabled: true, action: PaletteAction.reset-columns },
        { label: @tr("Write ID3v2.4 by default"), category: @tr("Settings"), enabled: root.id3v2-3, action: PaletteAction.default-id3v2-4 },
        { label: @tr("Write ID3v2.3 by default"), category: @tr("Settings"), enabled: !root.id3v2-3, action: PaletteAction.default-id3v2-3 },
        { label: @tr("ID3v1 policy: keep where it exists"), category: @tr("Settings"), enabled: root.id3v1-policy != Id3v1Policy.keep, action: PaletteAction.id3v1-keep },
        { label: @tr("ID3v1 policy: always write"), category: @tr("Settings"), enabled: root.id3v1-policy != Id3v1Policy.always, action: PaletteAction.id3v1-always },
        { label: @tr("ID3v1 policy: never write"), category: @tr("Settings"), enabled: root.id3v1-policy != Id3v1Policy.never, action: PaletteAction.id3v1-never },
        { label: root.developer-mode ? @tr("Turn developer mode off") : @tr("Turn developer mode on"), category: @tr("Settings"), enabled: true, action: PaletteAction.toggle-developer-mode },
    ];

    public function focus-filter() {
        filter.focus-field();
    }
    // Dialog buttons in the order of Windows. Tests set it so that their captures do not depend
    // on the machine.
    in property <bool> windows-buttons: Platform.os == OperatingSystemType.windows;
    callback toggle-column(TrackColumn);
    // A choice of the inspector's Tag format section, by its place: none, then each version.
    callback choose-id3v2(int);
    callback choose-id3v1(int);
    // The cover of the selected tracks.
    callback replace-cover;
    callback extract-cover;
    callback remove-cover;
    callback resize-columns(TrackColumnWidths);
    // The column the table is sorted by, if it is, and which way.
    in property <bool> sorted;
    in property <SortColumn> sorted-by;
    in property <bool> sort-descending;
    callback sort-by(SortColumn);
    // The sidebar's sources, and the one the table lists, which titles the window.
    in property <[SidebarItem]> library-sources;
    in property <[SidebarItem]> folder-sources;
    in property <[SidebarItem]> album-sources;
    in property <[SidebarItem]> first-album-sources;
    in property <[SidebarItem]> artist-sources;
    in property <SourceKind> shown-kind;
    in property <int> shown-index;
    in property <string> shown-label;
    callback show-source(SourceKind, int);
    // The text of the toolbar's filter field.
    callback filter-edited(string);
    // The player: whether sound can play, what plays, where and how loud.
    in property <bool> player-available;
    in property <bool> player-has-track;
    in property <bool> player-playing;
    in property <string> player-title;
    in property <string> player-artist;
    in property <float> player-progress;
    in property <string> player-position;
    in property <string> player-duration;
    in property <float> player-volume;
    in property <image> player-waveform;
    in property <image> player-bass;
    in property <image> player-treble;
    in property <bool> player-has-waveform;
    callback player-seek(float);
    callback player-set-volume(float);
    // The application's name, then the source the table lists.
    out property <string> window-title: !root.folder-open ? "Colophon" : "Colophon · " + (root.shown-kind == SourceKind.all-tracks ? @tr("All tracks") : root.shown-kind == SourceKind.recently-changed ? @tr("Recently changed") : root.shown-kind == SourceKind.unreadable ? @tr("Unreadable files") : root.shown-label);
    // A click on a track, by its row, with Command (Ctrl elsewhere) or Shift held.
    callback track-pressed(int, bool, bool);
    callback play-row(int);

    property <length> sidebar-width: 220px;
    property <length> inspector-width: 320px;
    property <length> centre-min-width: 560px;
    property <bool> sidebar-fits: true;
    property <bool> sidebar-shown: root.sidebar-visible && root.sidebar-fits;

    // The sidebar gives way when the centre column would get too narrow. This is a changed
    // handler rather than a binding because the window's width itself depends on the sidebar.
    function update-sidebar-fit() {
        root.sidebar-fits = root.width - root.sidebar-width - (root.inspector-visible ? root.inspector-width : 0px) >= root.centre-min-width;
    }

    init => {
        root.update-sidebar-fit();
    }
    changed width => {
        root.update-sidebar-fit();
    }
    changed inspector-visible => {
        root.update-sidebar-fit();
    }

    title: root.window-title;
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 600px;
    background: Theme.border-subtle;
    default-font-family: "Inter";
    default-font-size: 13px;

    // Slint calls the Command key Control on macOS: the shortcuts read Command O, and Option Command S
    // and I as in the Finder, there.
    MenuBar {
        Menu {
            title: @tr("File");

            MenuItem {
                title: @tr("Open Folder…");
                shortcut: @keys(Control + O);
                enabled: !root.modal;
                activated => {
                    root.run(Command.open-folder);
                }
            }

            MenuItem {
                title: @tr("Open Files…");
                shortcut: @keys(Control + Shift + O);
                enabled: !root.modal;
                activated => {
                    root.run(Command.open-files);
                }
            }

            MenuSeparator { }

            MenuItem {
                title: @tr("Save");
                shortcut: @keys(Control + S);
                enabled: root.modified-count > 0 && !root.saving && !root.modal;
                activated => {
                    root.run(Command.save);
                }
            }

            // Settings live in the File menu on macOS and Windows, where Windows calls them
            // Options, and in the Edit menu on Linux, as Preferences.
            if !root.linux: MenuSeparator { }

            if !root.linux: MenuItem {
                title: root.windows-buttons ? @tr("Options…") : @tr("Settings…");
                shortcut: @keys(Control + ",");
                enabled: !root.modal;
                activated => {
                    root.settings-open = true;
                }
            }
        }

        Menu {
            title: @tr("Edit");

            MenuItem {
                title: @tr("Undo");
                shortcut: @keys(Control + Z);
                enabled: root.can-undo && !root.modal;
                activated => {
                    root.run(Command.undo);
                }
            }

            MenuItem {
                title: @tr("Redo");
                shortcut: @keys(Control + Shift + Z);
                enabled: root.can-redo && !root.modal;
                activated => {
                    root.run(Command.redo);
                }
            }

            MenuSeparator { }

            MenuItem {
                title: @tr("Find");
                shortcut: @keys(Control + F);
                enabled: root.folder-open && !root.modal;
                activated => {
                    filter.focus-field();
                }
            }

            MenuSeparator { }

            MenuItem {
                title: @tr("Select Album");
                enabled: root.selected-count > 0 && !root.modal;
                activated => {
                    root.run(Command.select-album);
                }
            }

            MenuItem {
                title: @tr("Number Tracks");
                enabled: root.selected-count > 0 && !root.modal;
                activated => {
                    root.run(Command.number-tracks);
                }
            }

            if root.linux: MenuSeparator { }

            if root.linux: MenuItem {
                title: @tr("Preferences…");
                shortcut: @keys(Control + ",");
                enabled: !root.modal;
                activated => {
                    root.settings-open = true;
                }
            }
        }

        Menu {
            title: @tr("Controls");

            MenuItem {
                title: root.player-playing ? @tr("Pause") : @tr("Play");
                enabled: root.player-available && root.folder-open && !root.modal;
                activated => {
                    root.run(Command.play-pause);
                }
            }

            MenuItem {
                title: @tr("Next Track");
                enabled: root.player-has-track && !root.modal;
                activated => {
                    root.run(Command.play-next);
                }
            }

            MenuItem {
                title: @tr("Previous Track");
                enabled: root.player-has-track && !root.modal;
                activated => {
                    root.run(Command.play-previous);
                }
            }
        }

        Menu {
            title: @tr("View");

            MenuItem {
                title: @tr("Command Palette…");
                shortcut: @keys(Control + K);
                enabled: !root.modal;
                activated => {
                    root.palette-open = true;
                }
            }

            MenuSeparator { }

            MenuItem {
                title: root.sidebar-visible ? @tr("Hide Sidebar") : @tr("Show Sidebar");
                shortcut: @keys(Control + Alt + S);
                activated => {
                    root.run(Command.toggle-sidebar);
                }
            }

            MenuItem {
                title: root.inspector-visible ? @tr("Hide Inspector") : @tr("Show Inspector");
                shortcut: @keys(Control + Alt + I);
                activated => {
                    root.run(Command.toggle-inspector);
                }
            }

        }
    }

    VerticalLayout {
        spacing: 1px;

        Rectangle {
            height: 40px;
            background: Theme.surface-2;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 4px;

                ToolbarButton {
                    icon: @image-url("images/folder.svg");
                    label: @tr("Open folder");
                    clicked => {
                        root.run(Command.open-folder);
                    }
                }

                SaveButton {
                    count: root.modified-count;
                    saving: root.saving;
                    clicked => {
                        root.run(Command.save);
                    }
                }

                Rectangle {
                    width: 9px;

                    Rectangle {
                        width: 1px;
                        height: 18px;
                        background: Theme.border-subtle;
                    }
                }

                ToolbarButton {
                    icon: @image-url("images/undo.svg");
                    label: @tr("Undo");
                    enabled: root.can-undo && !root.modal;
                    clicked => {
                        root.run(Command.undo);
                    }
                }

                ToolbarButton {
                    icon: @image-url("images/redo.svg");
                    label: @tr("Redo");
                    enabled: root.can-redo && !root.modal;
                    clicked => {
                        root.run(Command.redo);
                    }
                }

                Rectangle {
                    width: 8px;
                }

                filter := FilterField {
                    max-width: 440px;
                    horizontal-stretch: 1;
                    shortcut: root.mac-shortcuts ? "⌘F" : "Ctrl+F";
                    edited(text) => {
                        root.filter-edited(text);
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: palette-key.preferred-width + 16px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    background: palette-touch.has-hover && !root.modal ? Theme.surface-3 : transparent;
                    animate background { duration: 100ms; }
                    accessible-role: button;
                    accessible-label: @tr("Command palette");
                    accessible-enabled: !root.modal;
                    accessible-action-default => {
                        root.palette-open = true;
                    }

                    palette-key := Text {
                        text: root.mac-shortcuts ? "⌘K" : "Ctrl+K";
                        font-size: 11px;
                        color: Theme.text-secondary;
                        accessible-role: none;
                    }

                    palette-touch := TouchArea {
                        enabled: !root.modal;
                        clicked => {
                            root.palette-open = true;
                        }
                    }
                }

                ToolbarButton {
                    icon: @image-url("images/panel-left.svg");
                    label: @tr("Toggle sidebar");
                    checkable: true;
                    checked: root.sidebar-visible;
                    clicked => {
                        root.run(Command.toggle-sidebar);
                    }
                }

                ToolbarButton {
                    icon: @image-url("images/panel-right.svg");
                    label: @tr("Toggle inspector");
                    checkable: true;
                    checked: root.inspector-visible;
                    clicked => {
                        root.run(Command.toggle-inspector);
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 1px;

            if root.sidebar-shown: Sidebar {
                width: root.sidebar-width;
                library: root.library-sources;
                folders: root.folder-sources;
                albums: root.album-sources;
                first-albums: root.first-album-sources;
                artists: root.artist-sources;
                shown-kind: root.shown-kind;
                shown-index: root.shown-index;
                show(kind, index) => {
                    root.show-source(kind, index);
                }
            }

            VerticalLayout {
                spacing: 1px;

                if !root.folder-open: EmptyState {
                    open-shortcut: root.mac-shortcuts ? "⌘O" : "Ctrl+O";
                    open-folder => {
                        root.run(Command.open-folder);
                    }
                }

                if root.folder-open: TrackTable {
                    rows: root.tracks;
                    columns: root.columns;
                    sized: root.columns-sized;
                    sized-widths: root.column-widths;
                    longest: root.longest;
                    focused-row: root.focused-row;
                    selected-count: root.selected-count;
                    track-pressed(row, toggle, extend) => {
                        root.track-pressed(row, toggle, extend);
                    }
                    select-all => {
                        root.run(Command.select-all);
                    }
                    step-selection(up, extend) => {
                        root.run(up ? (extend ? Command.extend-selection-up : Command.select-previous) : (extend ? Command.extend-selection-down : Command.select-next));
                    }
                    columns-resized(widths) => {
                        root.resize-columns(widths);
                    }
                    toggle-column(column) => {
                        root.toggle-column(column);
                    }
                    reset-columns => {
                        root.run(Command.reset-columns);
                    }
                    sorted: root.sorted;
                    sorted-by: root.sorted-by;
                    sort-descending: root.sort-descending;
                    sort-by(column) => {
                        root.sort-by(column);
                    }
                    play-pause => {
                        root.run(Command.play-pause);
                    }
                    can-play: root.player-available;
                    selection-modified: root.inspected-tracks.has-changes;
                    play-row(row) => {
                        root.play-row(row);
                    }
                    select-album => {
                        root.run(Command.select-album);
                    }
                    number-tracks => {
                        root.run(Command.number-tracks);
                    }
                    revert => {
                        root.run(Command.revert);
                    }
                }

                // Out of the way until a track plays.
                if root.player-has-track: PlayerBar {
                    available: root.player-available;
                    has-track: root.player-has-track;
                    playing: root.player-playing;
                    title: root.player-title;
                    artist: root.player-artist;
                    progress: root.player-progress;
                    position: root.player-position;
                    duration: root.player-duration;
                    volume: root.player-volume;
                    waveform: root.player-waveform;
                    bass: root.player-bass;
                    treble: root.player-treble;
                    has-waveform: root.player-has-waveform;
                    play-pause => {
                        root.run(Command.play-pause);
                    }
                    previous => {
                        root.run(Command.play-previous);
                    }
                    next => {
                        root.run(Command.play-next);
                    }
                    seek(progress) => {
                        root.player-seek(progress);
                    }
                    set-volume(volume) => {
                        root.player-set-volume(volume);
                    }
                }
            }

            if root.inspector-visible: Inspector {
                width: root.inspector-width;
                state: root.inspector-state;
                tracks: root.inspected-tracks;
                unreadable: root.unreadable-file;
                select-all-shortcut: root.mac-shortcuts ? "⌘A" : "Ctrl+A";
                modified-count: root.modified-count;
                saving: root.saving;
                developer-mode: root.developer-mode;
                has-spectrum: root.has-spectrum;
                spectrum: root.spectrum;
                choose-id3v2(index) => {
                    root.choose-id3v2(index);
                }
                choose-id3v1(index) => {
                    root.choose-id3v1(index);
                }
                replace-cover => {
                    root.replace-cover();
                }
                extract-cover => {
                    root.extract-cover();
                }
                remove-cover => {
                    root.remove-cover();
                }
                revert => {
                    root.run(Command.revert);
                }
                save => {
                    root.run(Command.save);
                }
            }
        }

        StatusBar {
            scan-state: root.scan-state;
            track-count: root.track-count;
            unreadable-count: root.unreadable-count;
            selected-count: root.selected-count;
            modified-count: root.modified-count;
            saving: root.saving;
            save-done: root.save-done;
            save-total: root.save-total;
            save-failures: root.save-failures;
            developer-mode: root.developer-mode;
            stop-scan => {
                root.run(Command.stop-scan);
            }
        }
    }

    if root.palette-open: CommandPalette {
        width: root.width;
        height: root.height;
        entries: root.palette-entries;
        filter(entries, query) => {
            return root.filter-palette(entries, query);
        }
        chosen(action) => {
            root.palette-open = false;
            root.palette-chosen(action);
        }
        close => {
            root.palette-open = false;
        }
    }

    if root.settings-open: Settings {
        width: root.width;
        height: root.height;
        windows-order: root.windows-buttons;
        id3v2-3: root.id3v2-3;
        id3v1-policy: root.id3v1-policy;
        developer-mode: root.developer-mode;
        choose-id3v2-3(older) => {
            root.choose-id3v2-3(older);
        }
        choose-id3v1-policy(policy) => {
            root.choose-id3v1-policy(policy);
        }
        toggle-developer-mode => {
            root.run(Command.toggle-developer-mode);
        }
        close => {
            root.settings-open = false;
        }
    }

    if root.asking-to-save: UnsavedChanges {
        width: root.width;
        height: root.height;
        count: root.modified-count;
        titles: root.unsaved-titles;
        windows-order: root.windows-buttons;
        chose(choice) => {
            root.unsaved-changes(choice);
        }
    }

    if root.confirming-removal: ConfirmTagRemoval {
        width: root.width;
        height: root.height;
        removal: root.removal;
        windows-order: root.windows-buttons;
        answered(remove) => {
            root.removal-answered(remove);
        }
    }
}

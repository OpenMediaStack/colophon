import { AboutSlint } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Dialog } from "dialog.slint";
import { ListView, ScrollBar } from "widgets.slint";

// A piece of software Colophon ships, under its licenses.
export struct Notice {
    name: string,
    // Empty for the fonts and icons.
    version: string,
    // The names of its licenses.
    license: string,
    // Where its source code is, if known.
    source: string,
    text: string,
}

// An address opened in the browser.
component Link inherits Text {
    in property <string> url: root.text;

    overflow: elide;
    color: Theme.accent-text;
    accessible-role: button;
    accessible-action-default => {
        Platform.open-url(root.url);
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Platform.open-url(root.url);
        }
    }
}

// Colophon's version and license, Slint's credit, and the licenses of what Colophon ships.
export component About inherits Dialog {
    in property <string> version;
    // What Colophon ships, which the bridge gives the first time the licenses show.
    in property <[Notice]> notices;
    callback notices-wanted;
    callback close;
    property <bool> licenses-shown;
    property <int> selected;
    property <Notice> notice: root.notices[root.selected];

    label: @tr("About Colophon");
    title: root.licenses-shown ? @tr("Third-party licenses") : "";
    message: root.licenses-shown ? @tr("Colophon ships these fonts, icons and crates, each under its own license.") : "";
    box-width: root.licenses-shown ? 760px : 400px;
    primary-text: @tr("Close");
    cancel-text: "";
    discard-text: root.licenses-shown ? @tr("Back") : @tr("Third-party licenses");
    primary => {
        root.close();
    }
    cancel => {
        root.close();
    }
    discard => {
        if !root.licenses-shown {
            root.notices-wanted();
        }
        root.licenses-shown = !root.licenses-shown;
    }

    if !root.licenses-shown: VerticalLayout {
        spacing: 16px;

        HorizontalLayout {
            spacing: 14px;
            alignment: start;

            Image {
                width: 56px;
                height: 56px;
                source: @image-url("../../../assets/icon/png/colophon-128.png");
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;

                Text {
                    text: "Colophon";
                    font-size: 18px;
                    font-weight: 600;
                    color: Theme.text-primary;
                }

                Text {
                    text: @tr("Version {}", root.version);
                    color: Theme.text-secondary;
                }
            }
        }

        VerticalLayout {
            spacing: 4px;

            Text {
                text: @tr("An MP3 tag editor.");
                wrap: word-wrap;
                color: Theme.text-secondary;
            }

            Text {
                text: "© 2026 Florent Sorel. " + @tr("Released under the MIT License.");
                wrap: word-wrap;
                font-size: 12px;
                color: Theme.text-tertiary;
            }

            Link {
                text: "github.com/florentsorel/colophon";
                url: "https://github.com/florentsorel/colophon";
                font-size: 12px;
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border-subtle;
        }

        // Slint's royalty-free license asks for it in the About dialog.
        AboutSlint {
            height: self.min-height;
        }
    }

    if root.licenses-shown: HorizontalLayout {
        height: 360px;
        spacing: 16px;

        Rectangle {
            width: 240px;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border-subtle;
            clip: true;

            entries := ListView {
                accessible-role: list;
                accessible-label: @tr("Third-party licenses");

                for notice[index] in root.notices: Rectangle {
                    height: 44px;
                    background: index == root.selected ? Theme.accent-selection : touch.has-hover ? Theme.surface-3 : transparent;
                    accessible-role: list-item;
                    accessible-label: notice.name;
                    accessible-item-selected: index == root.selected;
                    accessible-action-default => {
                        root.selected = index;
                        text-view.content-y = 0;
                    }

                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: center;
                        spacing: 1px;

                        Text {
                            text: notice.name;
                            overflow: elide;
                            color: Theme.text-primary;
                        }

                        Text {
                            text: notice.version == "" ? notice.license : notice.version + " · " + notice.license;
                            overflow: elide;
                            font-size: 11px;
                            color: Theme.text-tertiary;
                        }
                    }

                    touch := TouchArea {
                        clicked => {
                            root.selected = index;
                            text-view.content-y = 0;
                        }
                    }
                }
            }

            ScrollBar {
                x: parent.width - 8px;
                width: 8px;
                content-size: entries.content-height;
                visible-size: entries.visible-height;
                position <=> entries.content-y;
                accessible-label: @tr("Third-party licenses scroll bar");
            }
        }

        VerticalLayout {
            spacing: 4px;

            Text {
                text: root.notice.version == "" ? root.notice.name : root.notice.name + " " + root.notice.version;
                overflow: elide;
                font-size: 14px;
                font-weight: 600;
                color: Theme.text-primary;
            }

            Text {
                text: root.notice.license;
                overflow: elide;
                color: Theme.text-secondary;
            }

            if root.notice.source != "": Link {
                text: root.notice.source;
                font-size: 12px;
            }

            Rectangle {
                vertical-stretch: 1;
                border-radius: 6px;
                border-width: 1px;
                border-color: Theme.border-subtle;
                clip: true;

                text-view := Flickable {
                    content-height: license-text.preferred-height + 20px;

                    license-text := Text {
                        x: 12px;
                        y: 10px;
                        width: text-view.width - 28px;
                        text: root.notice.text;
                        wrap: word-wrap;
                        font-size: 12px;
                        color: Theme.text-secondary;
                    }
                }

                ScrollBar {
                    x: parent.width - 8px;
                    width: 8px;
                    content-size: text-view.content-height;
                    visible-size: text-view.height;
                    position <=> text-view.content-y;
                    accessible-label: @tr("License scroll bar");
                }
            }
        }
    }
}

import { Theme } from "theme.slint";
import { Button, Checkbox, ScrollBar, Segmented } from "widgets.slint";
import { TagEditing, TagField } from "tag-editing.slint";
import { SuggestionList } from "suggestions.slint";

// Empty while no folder is open.
export enum InspectorState { empty, nothing-selected, tracks, unreadable }

// One field of the selected tracks: their shared value, or several, and whether it waits to be saved.
export struct InspectorField {
    text: string,
    mixed: bool,
    modified: bool,
}

// The fields an ID3v1 tag will not hold whole.
export struct Id3v1Losses {
    title: bool,
    artist: bool,
    album: bool,
    year: bool,
    comment: bool,
    track: bool,
    genre: bool,
}

export enum SizeUnit { bytes, kilobytes, megabytes, gigabytes }

export enum BitrateMode { unknown, constant, variable }

// A size, in decimal units with one decimal digit, put into words by the inspector so that each
// language writes its own decimal mark and units.
export struct ByteSize {
    whole: int,
    tenth: int,
    unit: SizeUnit,
}

// What the selected tracks share of their covers.
export enum CoverState { none, shared, mixed }

export struct InspectedTracks {
    count: int,
    unreadable: int,
    cover-state: CoverState,
    // The cover the tracks share, drawn small.
    cover: image,
    // The cover waits to be saved.
    cover-modified: bool,
    // The title of a single track, or its file name.
    heading: string,
    title: InspectorField,
    artist: InspectorField,
    album-artist: InspectorField,
    album: InspectorField,
    year: InspectorField,
    track: InspectorField,
    track-total: InspectorField,
    // What looks wrong beside the rest of their albums, in at least one of the tracks.
    missing-number: bool,
    odd-album-artist: bool,
    disc: InspectorField,
    disc-total: InspectorField,
    genre: InspectorField,
    comment: InspectorField,
    // Whether the tracks share their audio properties, and these.
    audio-shared: bool,
    bitrate: int,
    bitrate-mode: BitrateMode,
    sample-rate-whole: int,
    sample-rate-tenth: int,
    formats: InspectorField,
    size: ByteSize,
    // At least one selected track has changes waiting to be saved.
    has-changes: bool,
    // The tags those tracks will hold once saved, and what their ID3v1 tags will lose.
    saved-as: InspectorField,
    id3v1-losses: Id3v1Losses,
    // How many of them saving converts to other tags or versions.
    converted: int,
    // The versions saving writes the tracks in, by their place in the Tag format section's
    // choices: none first, then each version. -1 while the tracks have several.
    id3v2-choice: int,
    id3v1-choice: int,
}

export enum ReadProblem { cannot-open, damaged, reader-failed }

// What a frame of an ID3v2 tag holds.
export enum FrameKind { text, picture, sealed, binary }

// A frame of an ID3v2 tag, as developer mode shows it.
export struct TagFrame {
    id: string,
    kind: FrameKind,
    // Its text, or the type of its picture.
    value: string,
    // The size of its picture.
    data-size: int,
    // Where its header starts in the file, and the size of its content.
    offset: int,
    size: int,
    // The encoding of its text, as the specification names it; empty for other frames.
    encoding: string,
    read-only: bool,
    grouping: bool,
    compression: bool,
    encryption: bool,
    unsynchronisation: bool,
    data-length: bool,
}

// How the tags of a file are laid out, byte by byte.
export struct TagLayout {
    has-id3v2: bool,
    // Its version and revision, such as 3.0.
    version: string,
    size: int,
    padding: int,
    unsynchronisation: bool,
    extended-header: bool,
    experimental: bool,
    footer: bool,
    frames: [TagFrame],
    has-id3v1: bool,
    id3v1-offset: int,
}

export struct UnreadableFile {
    path: string,
    problem: ReadProblem,
    size: ByteSize,
}

component SectionLabel inherits Text {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.66px;
    color: Theme.text-tertiary;
}

// The title of a section, which hides the section or shows it again.
component SectionHeader inherits Rectangle {
    in property <string> text;
    in-out property <bool> open: true;

    height: 16px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-expandable: true;
    accessible-expanded: root.open;
    accessible-action-default => {
        root.open = !root.open;
    }

    HorizontalLayout {
        alignment: start;
        spacing: 4px;

        Image {
            width: 12px;
            y: (parent.height - self.height) / 2;
            source: @image-url("images/chevron-down.svg");
            colorize: touch.has-hover ? Theme.text-secondary : Theme.text-tertiary;
            transform-rotation: root.open ? 0deg : -90deg;
            animate transform-rotation { duration: 100ms; }
        }

        SectionLabel {
            vertical-alignment: center;
            text: root.text.to-uppercase();
            color: touch.has-hover ? Theme.text-secondary : Theme.text-tertiary;
        }
    }

    touch := TouchArea {
        clicked => {
            root.open = !root.open;
        }
    }
}

component FieldLabel inherits HorizontalLayout {
    in property <string> text;
    in property <length> size: 13px;
    // A dot takes the place of the padding while the field waits to be saved.
    in property <bool> modified;

    width: 96px;
    padding-left: root.modified ? 0px : 12px;
    spacing: 6px;

    if root.modified: Rectangle {
        width: 6px;
        height: 6px;
        y: (parent.height - self.height) / 2;
        border-radius: 3px;
        background: Theme.accent;
    }

    Text {
        vertical-alignment: center;
        text: root.text;
        font-size: root.size;
        color: root.modified ? Theme.text-primary : Theme.text-secondary;
    }
}

// A field of the inspector. Enter, or leaving the field, keeps what was typed; Escape puts the
// value back. Where the tracks differ, the field starts empty and typing sets them all.
component EditField inherits Rectangle {
    in property <InspectorField> field;
    in property <TagField> tag;
    in property <string> label;
    in property <bool> mono;
    in property <string> mixed-text: @tr("Multiple values");
    in property <bool> multiline;
    // Suggests genres as the user types, with a button that shows them all.
    in property <bool> suggests;
    // The suggestions shown under the field, and the one the arrow keys reached.
    out property <bool> suggesting: root.list-open && input.has-focus && root.suggestions.length > 0;
    out property <[string]> suggestions: root.list-open ? TagEditing.genres(root.filter) : [];
    out property <int> highlighted: -1;

    property <string> value: root.field.mixed ? "" : root.field.text;
    property <bool> invalid: TagEditing.invalid(root.tag, input.text);
    // What the field held when it took the focus, and whether a value was kept since: each key
    // is kept at once, so that saving never misses what was just typed.
    property <string> started-with;
    property <bool> typing;
    property <bool> list-open;
    // What the suggestions match: the text typed, or nothing for every genre.
    property <string> filter;

    function restore() {
        input.text = root.value;
    }

    function keep-text() {
        if root.invalid {
            // The engine keeps the value from before, until the text makes sense again.
            root.cancel();
        } else if input.text != root.value {
            TagEditing.commit(root.tag, input.text, root.typing);
            root.typing = true;
        }
    }

    function open-list(filter: string) {
        root.filter = filter;
        root.highlighted = -1;
        root.list-open = true;
    }

    public function pick(value: string) {
        input.text = value;
        root.list-open = false;
        root.keep-text();
        input.clear-focus();
    }

    // Undoes what was typed since the field took the focus.
    function cancel() {
        if root.typing {
            TagEditing.cancel-typing();
            root.typing = false;
        }
    }

    // The engine's value changed, after an undo or another selection; typing keeps its text.
    changed value => {
        if !input.has-focus {
            root.restore();
        }
    }

    min-height: 28px;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.invalid ? Theme.error : input.has-focus ? Theme.focus-ring : root.field.modified ? Theme.modified-border : Theme.border-strong;
    background: Theme.surface-2;

    if root.field.mixed && input.text == "": Text {
        x: 8px;
        y: root.multiline ? 6px : 0px;
        width: parent.width - 16px;
        height: root.multiline ? self.preferred-height : parent.height;
        vertical-alignment: center;
        overflow: elide;
        text: root.mixed-text;
        color: Theme.text-tertiary;
    }

    input := TextInput {
        x: 8px;
        y: root.multiline ? 6px : 0px;
        width: parent.width - (root.suggests ? 30px : 16px);
        height: root.multiline ? parent.height - 12px : parent.height;
        text: root.value;
        single-line: !root.multiline;
        wrap: root.multiline ? word-wrap : no-wrap;
        vertical-alignment: root.multiline ? top : center;
        font-family: root.mono ? "JetBrains Mono" : "Inter";
        font-size: root.mono ? 12px : 13px;
        color: Theme.text-primary;
        selection-background-color: Theme.accent-selection;
        selection-foreground-color: Theme.text-primary;
        accessible-label: root.label;

        edited => {
            root.keep-text();
            if root.suggests {
                root.open-list(self.text);
            }
        }
        accepted => {
            if !root.invalid {
                self.clear-focus();
            }
        }
        key-pressed(event) => {
            if root.suggesting {
                if event.text == Key.DownArrow {
                    root.highlighted = min(root.highlighted + 1, root.suggestions.length - 1);
                    return accept;
                }
                if event.text == Key.UpArrow {
                    root.highlighted = max(root.highlighted - 1, -1);
                    return accept;
                }
                if event.text == Key.Return && root.highlighted >= 0 {
                    root.pick(root.suggestions[root.highlighted]);
                    return accept;
                }
                if event.text == Key.Escape {
                    root.list-open = false;
                    return accept;
                }
            } else if root.suggests && event.text == Key.DownArrow {
                root.open-list("");
                return accept;
            }
            if event.text == Key.Escape {
                root.cancel();
                self.text = root.started-with;
                self.clear-focus();
                return accept;
            }
            return reject;
        }
        changed has-focus => {
            if self.has-focus {
                root.started-with = root.value;
            } else {
                root.list-open = false;
                if root.invalid {
                    root.cancel();
                    self.text = root.started-with;
                }
                root.typing = false;
            }
        }
    }

    if root.suggests: Rectangle {
        x: parent.width - self.width - 4px;
        width: 22px;
        height: parent.height;
        accessible-role: button;
        accessible-label: @tr("Show suggestions");
        accessible-action-default => {
            input.focus();
            root.open-list("");
        }

        Image {
            width: 14px;
            height: 14px;
            source: @image-url("images/chevron-down.svg");
            colorize: Theme.text-tertiary;
        }

        TouchArea {
            clicked => {
                input.focus();
                root.open-list("");
            }
        }
    }
}

component FileValue inherits Text {
    in property <bool> mono;

    vertical-alignment: center;
    wrap: word-wrap;
    font-family: root.mono ? "JetBrains Mono" : "Inter";
    font-size: 12px;
    color: Theme.text-primary;
}

// Something that looks wrong in the tags, with the warning colour and sign.
component Warning inherits HorizontalLayout {
    in property <string> text;

    spacing: 6px;

    Image {
        width: 14px;
        height: 14px;
        y: 1px;
        source: @image-url("images/triangle-alert.svg");
        colorize: Theme.warning;
    }

    Text {
        horizontal-stretch: 1;
        wrap: word-wrap;
        text: root.text;
        font-size: 12px;
        color: Theme.warning;
    }
}

// The panel at the right of the window: the tags of the selected tracks.
export component Inspector inherits Rectangle {
    in property <InspectorState> state;
    in property <InspectedTracks> tracks;
    in property <UnreadableFile> unreadable;
    // How Select All is written on this system: ⌘A or Ctrl+A.
    in property <string> select-all-shortcut;
    // The files with changes waiting to be saved, and whether a save runs.
    in property <int> modified-count;
    in property <bool> saving;
    // Shows the Tag format section, which chooses the versions to write.
    in property <bool> developer-mode;
    callback revert;
    callback save;
    // A choice of the Tag format section, by its place.
    callback choose-id3v2(int);
    callback choose-id3v1(int);
    callback replace-cover;
    callback extract-cover;
    callback remove-cover;
    // The unreadable file: shown in the system's file manager, whose name the button takes, or
    // its details put on the clipboard.
    in property <string> reveal-text;
    callback reveal-file;
    callback copy-details;
    // An image dragged over the window would replace the cover.
    in property <bool> cover-drop;
    // How ID3v2 tags are encoded when saved in developer mode, by the place of each choice:
    // the text encoding and the padding, the first choice leaving it to Colophon.
    in property <int> encoding-choice;
    in property <int> padding-choice;
    in property <bool> unsynchronisation;
    callback choose-encoding(int);
    callback choose-padding(int);
    callback toggle-unsynchronisation;
    // Marks the selected tracks to be written again as they are.
    callback rewrite;
    // Which sections show their content; the others show their title alone.
    in-out property <bool> tags-open: true;
    in-out property <bool> file-open: true;
    in-out property <bool> tag-format-open: true;
    in-out property <bool> frames-open: true;
    // How the tags of the single selected track are laid out, in developer mode.
    in property <bool> has-layout;
    in property <TagLayout> layout;

    pure function frame-value(frame: TagFrame) -> string {
        return frame.kind == FrameKind.text ? frame.value
            : frame.kind == FrameKind.picture ? @tr("{}, {} bytes", frame.value, frame.data-size)
            : frame.kind == FrameKind.sealed ? @tr("Compressed or encrypted")
            : @tr("{n} byte of data" | "{n} bytes of data" % frame.size);
    }

    // Two parts of a line, with a dot between them when both are there.
    pure function joined(first: string, second: string) -> string {
        return first == "" ? second : second == "" ? first : first + " · " + second;
    }

    pure function frame-details(frame: TagFrame) -> string {
        return root.joined(root.joined(root.joined(root.joined(root.joined(root.joined(root.joined(
            @tr("at {}", frame.offset) + " · " + @tr("{n} byte" | "{n} bytes" % frame.size),
            frame.encoding),
            frame.read-only ? @tr("read only") : ""),
            frame.grouping ? @tr("grouped") : ""),
            frame.compression ? @tr("compressed") : ""),
            frame.encryption ? @tr("encrypted") : ""),
            frame.unsynchronisation ? @tr("unsynchronised") : ""),
            frame.data-length ? @tr("data length") : "");
    }

    pure function tag-flags() -> string {
        return root.joined(root.joined(root.joined(
            root.layout.unsynchronisation ? @tr("Unsynchronised") : "",
            root.layout.extended-header ? @tr("Extended header") : ""),
            root.layout.experimental ? @tr("Experimental") : ""),
            root.layout.footer ? @tr("Footer") : "");
    }

    property <length> scrollbar-size: 10px;
    // The player's height and the line above it, so that the line above the actions continues
    // the one above the player.
    property <length> actions-height: 57px;
    property <string> album-and-artist: root.tracks.album.mixed || root.tracks.album.text == "" ? root.shared-artist
        : root.shared-artist == "" ? root.tracks.album.text
        : root.tracks.album.text + " · " + root.shared-artist;
    property <string> shared-artist: root.tracks.artist.mixed ? "" : root.tracks.artist.text;

    pure function size-text(size: ByteSize) -> string {
        if size.unit == SizeUnit.bytes {
            return @tr("{n}\u{a0}byte" | "{n}\u{a0}bytes" % size.whole);
        }
        if size.unit == SizeUnit.kilobytes {
            return @tr("{}\u{a0}KB", size.whole);
        }
        if size.unit == SizeUnit.megabytes {
            return @tr("{0}.{1}\u{a0}MB", size.whole, size.tenth);
        }
        return @tr("{0}.{1}\u{a0}GB", size.whole, size.tenth);
    }

    pure function join(names: string, name: string, lost: bool) -> string {
        return !lost ? names : names == "" ? name : names + ", " + name;
    }

    pure function lost-names(losses: Id3v1Losses) -> string {
        return root.join(root.join(root.join(root.join(root.join(root.join(root.join("", @tr("Title"), losses.title), @tr("Artist"), losses.artist), @tr("Album"), losses.album), @tr("Year"), losses.year), @tr("Comment"), losses.comment), @tr("Track"), losses.track), @tr("Genre"), losses.genre);
    }

    // What saving does to the tags of the files it converts.
    pure function conversion-text() -> string {
        if root.tracks.converted == 0 {
            return "";
        }
        if root.tracks.saved-as.mixed {
            return @tr("Saving converts {n} file." | "Saving converts {n} files." % root.tracks.converted);
        }
        if root.tracks.saved-as.text == "" {
            return @tr("Saving removes the tags of {n} file." | "Saving removes the tags of {n} files." % root.tracks.converted);
        }
        if root.tracks.formats.mixed || root.tracks.formats.text == "" {
            return @tr("Saving converts {n} file to {0}." | "Saving converts {n} files to {0}." % root.tracks.converted, root.tracks.saved-as.text);
        }
        return @tr("Saving converts {n} file from {0} to {1}." | "Saving converts {n} files from {0} to {1}." % root.tracks.converted, root.tracks.formats.text, root.tracks.saved-as.text);
    }

    pure function audio-text() -> string {
        if !root.tracks.audio-shared {
            return @tr("Multiple values");
        }
        return "MP3 · " + @tr("{}\u{a0}kbps", root.tracks.bitrate)
            + (root.tracks.bitrate-mode == BitrateMode.constant ? "\u{a0}CBR" : root.tracks.bitrate-mode == BitrateMode.variable ? "\u{a0}VBR" : "")
            + " · " + (root.tracks.sample-rate-tenth == 0 ? @tr("{}\u{a0}kHz", root.tracks.sample-rate-whole) : @tr("{0}.{1}\u{a0}kHz", root.tracks.sample-rate-whole, root.tracks.sample-rate-tenth));
    }

    background: Theme.surface-1;
    accessible-role: groupbox;
    accessible-label: @tr("Inspector");

    if root.state == InspectorState.nothing-selected: VerticalLayout {
        alignment: center;
        padding: 16px;
        spacing: 6px;

        Text {
            horizontal-alignment: center;
            wrap: word-wrap;
            text: @tr("Select tracks to see their tags");
            color: Theme.text-secondary;
        }

        Text {
            horizontal-alignment: center;
            wrap: word-wrap;
            text: @tr("{} selects every track", root.select-all-shortcut);
            font-size: 12px;
            color: Theme.text-tertiary;
        }
    }

    if root.state == InspectorState.tracks: Rectangle {
        flick := Flickable {
            y: 0;
            height: parent.height - root.actions-height;
            mouse-drag-pan-enabled: false;
            content-height: column.preferred-height;

            column := VerticalLayout {
                width: flick.width;
                alignment: start;
                padding: 16px;
                spacing: 16px;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    ContextMenuArea {
                        width: 64px;
                        height: 64px;

                        Menu {
                            MenuItem {
                                title: @tr("Replace Cover…");
                                activated => {
                                    root.replace-cover();
                                }
                            }

                            MenuItem {
                                title: @tr("Extract Cover…");
                                enabled: root.tracks.cover-state == CoverState.shared;
                                activated => {
                                    root.extract-cover();
                                }
                            }

                            MenuItem {
                                title: @tr("Remove Cover");
                                enabled: root.tracks.cover-state != CoverState.none;
                                activated => {
                                    root.remove-cover();
                                }
                            }
                        }

                        Rectangle {
                            border-radius: 6px;
                            border-width: root.cover-drop ? 2px : 1px;
                            border-color: root.cover-drop ? Theme.accent : root.tracks.cover-modified ? Theme.modified-border : Theme.border-subtle;
                            background: root.cover-drop ? Theme.accent-selection : Theme.surface-2;
                            clip: true;
                            accessible-role: image;
                            accessible-label: root.tracks.cover-state == CoverState.shared ? @tr("Cover") : root.tracks.cover-state == CoverState.mixed ? @tr("Several covers") : @tr("No cover");

                            if root.tracks.cover-state == CoverState.shared: Image {
                                width: 100%;
                                height: 100%;
                                source: root.tracks.cover;
                                image-fit: cover;
                            }

                            if root.tracks.cover-state != CoverState.shared: Image {
                                width: 24px;
                                height: 24px;
                                source: @image-url("images/music.svg");
                                colorize: Theme.text-tertiary;
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;

                        Text {
                            wrap: word-wrap;
                            text: root.tracks.count == 1 ? root.tracks.heading : @tr("{n} track selected" | "{n} tracks selected" % root.tracks.count);
                            font-size: 15px;
                            font-weight: 600;
                            color: Theme.text-primary;
                        }

                        if root.album-and-artist != "": Text {
                            wrap: word-wrap;
                            text: root.album-and-artist;
                            color: Theme.text-secondary;
                        }

                        if root.tracks.unreadable > 0: Text {
                            wrap: word-wrap;
                            text: @tr("{n} file could not be read" | "{n} files could not be read" % root.tracks.unreadable);
                            font-size: 12px;
                            color: Theme.error;
                        }

                        HorizontalLayout {
                            alignment: start;
                            padding-top: 4px;

                            Button {
                                height: 24px;
                                text: @tr("Replace cover…");
                                clicked => {
                                    root.replace-cover();
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 8px;

                    SectionHeader {
                        text: @tr("Tags");
                        open <=> root.tags-open;
                    }

                    // Folded rather than left out, since the genre suggestions follow the genre field.
                    Rectangle {
                        height: root.tags-open ? tags-content.preferred-height : 0px;
                        clip: true;
                        visible: root.tags-open;

                        tags-content := VerticalLayout {
                            spacing: 8px;

                            if root.tracks.missing-number: Warning {
                                text: root.tracks.count == 1 ? @tr("This track has no number, unlike the rest of its album.") : @tr("Some of these tracks have no number, unlike the rest of their albums.");
                            }

                            if root.tracks.odd-album-artist: Warning {
                                text: root.tracks.count == 1 ? @tr("Its album artist differs from the rest of its album.") : @tr("Some of these tracks have an album artist that differs from the rest of their albums.");
                            }

                            GridLayout {
                                spacing-horizontal: 8px;
                                spacing-vertical: 6px;

                                Row {
                                    FieldLabel {
                                        text: @tr("Title");
                                        modified: root.tracks.title.modified;
                                    }

                                    EditField {
                                        field: root.tracks.title;
                                        tag: TagField.title;
                                        label: @tr("Title");
                                    }
                                }

                                Row {
                                    FieldLabel {
                                        text: @tr("Artist");
                                        modified: root.tracks.artist.modified;
                                    }

                                    EditField {
                                        field: root.tracks.artist;
                                        tag: TagField.artist;
                                        label: @tr("Artist");
                                    }
                                }

                                Row {
                                    FieldLabel {
                                        text: @tr("Album artist");
                                        modified: root.tracks.album-artist.modified;
                                    }

                                    EditField {
                                        field: root.tracks.album-artist;
                                        tag: TagField.album-artist;
                                        label: @tr("Album artist");
                                    }
                                }

                                Row {
                                    FieldLabel {
                                        text: @tr("Album");
                                        modified: root.tracks.album.modified;
                                    }

                                    EditField {
                                        field: root.tracks.album;
                                        tag: TagField.album;
                                        label: @tr("Album");
                                    }
                                }

                                Row {
                                    FieldLabel {
                                        text: @tr("Year");
                                        modified: root.tracks.year.modified;
                                    }

                                    EditField {
                                        field: root.tracks.year;
                                        tag: TagField.year;
                                        label: @tr("Year");
                                        mono: true;
                                    }
                                }

                                Row {
                                    FieldLabel {
                                        text: @tr("Track");
                                        modified: root.tracks.track.modified || root.tracks.track-total.modified;
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;

                                        EditField {
                                            width: 72px;
                                            field: root.tracks.track;
                                            tag: TagField.track;
                                            label: @tr("Track");
                                            mono: true;
                                            mixed-text: @tr("Multiple");
                                        }

                                        Text {
                                            vertical-alignment: center;
                                            text: @tr("of");
                                            color: Theme.text-tertiary;
                                        }

                                        EditField {
                                            width: 52px;
                                            field: root.tracks.track-total;
                                            tag: TagField.track-total;
                                            label: @tr("Track total");
                                            mono: true;
                                            mixed-text: "…";
                                        }
                                    }
                                }

                                Row {
                                    FieldLabel {
                                        text: @tr("Disc");
                                        modified: root.tracks.disc.modified || root.tracks.disc-total.modified;
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;

                                        EditField {
                                            width: 72px;
                                            field: root.tracks.disc;
                                            tag: TagField.disc;
                                            label: @tr("Disc");
                                            mono: true;
                                            mixed-text: @tr("Multiple");
                                        }

                                        Text {
                                            vertical-alignment: center;
                                            text: @tr("of");
                                            color: Theme.text-tertiary;
                                        }

                                        EditField {
                                            width: 52px;
                                            field: root.tracks.disc-total;
                                            tag: TagField.disc-total;
                                            label: @tr("Disc total");
                                            mono: true;
                                            mixed-text: "…";
                                        }
                                    }
                                }

                                Row {
                                    FieldLabel {
                                        text: @tr("Genre");
                                        modified: root.tracks.genre.modified;
                                    }

                                    genre-field := EditField {
                                        field: root.tracks.genre;
                                        tag: TagField.genre;
                                        label: @tr("Genre");
                                        suggests: true;
                                    }
                                }

                                Row {
                                    FieldLabel {
                                        text: @tr("Comment");
                                        modified: root.tracks.comment.modified;
                                    }

                                    EditField {
                                        height: 46px;
                                        field: root.tracks.comment;
                                        tag: TagField.comment;
                                        label: @tr("Comment");
                                        multiline: true;
                                    }
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 8px;

                    SectionHeader {
                        text: @tr("File");
                        open <=> root.file-open;
                    }

                    if root.file-open: VerticalLayout {
                        spacing: 8px;

                        GridLayout {
                            spacing-horizontal: 8px;
                            spacing-vertical: 4px;

                            Row {
                                FieldLabel {
                                    text: @tr("Audio");
                                    size: 12px;
                                }

                                FileValue {
                                    text: root.audio-text();
                                }
                            }

                            Row {
                                FieldLabel {
                                    text: @tr("Size");
                                    size: 12px;
                                }

                                FileValue {
                                    text: root.tracks.count == 1 ? root.size-text(root.tracks.size) : @tr("{} total", root.size-text(root.tracks.size));
                                    mono: true;
                                }
                            }

                            Row {
                                FieldLabel {
                                    text: @tr("Tags");
                                    size: 12px;
                                }

                                FileValue {
                                    text: root.tracks.formats.mixed ? @tr("Multiple values") : root.tracks.formats.text == "" ? @tr("None") : root.tracks.formats.text;
                                }
                            }

                            if root.tracks.has-changes: Row {
                                FieldLabel {
                                    text: @tr("Saved as");
                                    size: 12px;
                                }

                                FileValue {
                                    text: root.tracks.saved-as.mixed ? @tr("Multiple values") : root.tracks.saved-as.text;
                                }
                            }

                            if root.lost-names(root.tracks.id3v1-losses) != "": Row {
                                Rectangle { }

                                FileValue {
                                    text: @tr("ID3v1 will keep only part of: {}", root.lost-names(root.tracks.id3v1-losses));
                                    color: Theme.warning;
                                }
                            }
                        }
                    }
                }

                if root.developer-mode: VerticalLayout {
                    spacing: 8px;

                    SectionHeader {
                        text: @tr("Tag format");
                        open <=> root.tag-format-open;
                    }

                    if root.tag-format-open: VerticalLayout {
                        spacing: 8px;

                        GridLayout {
                            spacing-horizontal: 8px;
                            spacing-vertical: 6px;

                            Row {
                                FieldLabel {
                                    text: @tr("Write ID3v2");
                                }

                                Segmented {
                                    label: @tr("Write ID3v2");
                                    segments: [
                                        { label: @tr("None") },
                                        { label: "2.2", mono: true },
                                        { label: "2.3", mono: true },
                                        { label: "2.4", mono: true },
                                    ];
                                    selected: root.tracks.id3v2-choice;
                                    chosen(index) => {
                                        root.choose-id3v2(index);
                                    }
                                }
                            }

                            Row {
                                FieldLabel {
                                    text: @tr("Write ID3v1");
                                }

                                Segmented {
                                    label: @tr("Write ID3v1");
                                    segments: [
                                        { label: @tr("None") },
                                        { label: "1.0", mono: true },
                                        { label: "1.1", mono: true },
                                    ];
                                    selected: root.tracks.id3v1-choice;
                                    chosen(index) => {
                                        root.choose-id3v1(index);
                                    }
                                }
                            }

                            if root.conversion-text() != "": Row {
                                Rectangle { }

                                Text {
                                    text: root.conversion-text();
                                    wrap: word-wrap;
                                    font-size: 12px;
                                    color: Theme.text-tertiary;
                                }
                            }
                        }

                        FieldLabel {
                            text: @tr("Text encoding");
                        }

                        // In line with the labels above.
                        HorizontalLayout {
                            padding-left: 12px;

                            Segmented {
                                fit-labels: true;
                                label: @tr("Text encoding");
                                segments: [
                                    { label: @tr("Auto") },
                                    { label: "Latin-1" },
                                    { label: "UTF-16" },
                                    { label: "UTF-16BE" },
                                    { label: "UTF-8" },
                                ];
                                selected: root.encoding-choice;
                                chosen(index) => {
                                    root.choose-encoding(index);
                                }
                            }
                        }

                        FieldLabel {
                            text: @tr("Padding");
                        }

                        // In line with the labels above.
                        HorizontalLayout {
                            padding-left: 12px;

                            Segmented {
                                label: @tr("Padding");
                                segments: [
                                    { label: @tr("Auto") },
                                    { label: "0", mono: true },
                                    { label: "256", mono: true },
                                    { label: "1024", mono: true },
                                    { label: "4096", mono: true },
                                ];
                                selected: root.padding-choice;
                                chosen(index) => {
                                    root.choose-padding(index);
                                }
                            }
                        }

                        // In line with the labels above.
                        HorizontalLayout {
                            padding-left: 12px;

                            Checkbox {
                                text: @tr("Unsynchronisation");
                                checked: root.unsynchronisation;
                                toggled => {
                                    root.toggle-unsynchronisation();
                                }
                            }
                        }

                        // In line with the labels above.
                        HorizontalLayout {
                            padding-left: 12px;

                            Text {
                                wrap: word-wrap;
                                text: @tr("These apply to every file saved in developer mode. UTF-16BE and UTF-8 need ID3v2.4; earlier versions get UTF-16.");
                                font-size: 12px;
                                color: Theme.text-tertiary;
                            }
                        }

                        HorizontalLayout {
                            alignment: start;
                            padding-left: 12px;

                            Button {
                                text: @tr("Rewrite Selected Files");
                                clicked => {
                                    root.rewrite();
                                }
                            }
                        }
                    }
                }

                if root.developer-mode && root.has-layout: VerticalLayout {
                    spacing: 8px;

                    SectionHeader {
                        text: @tr("Frames");
                        open <=> root.frames-open;
                    }

                    if root.frames-open: VerticalLayout {
                        spacing: 8px;

                        Text {
                            wrap: word-wrap;
                            text: root.layout.has-id3v2 ? @tr("ID3v2.{} · {} bytes · {} bytes of padding", root.layout.version, root.layout.size, root.layout.padding) : @tr("No ID3v2 tag");
                            font-size: 12px;
                            color: Theme.text-secondary;
                        }

                        if root.tag-flags() != "": Text {
                            wrap: word-wrap;
                            text: root.tag-flags();
                            font-size: 12px;
                            color: Theme.text-secondary;
                        }

                        for frame in root.layout.frames: VerticalLayout {
                            spacing: 1px;
                            accessible-role: list-item;
                            accessible-label: frame.id + " " + root.frame-value(frame);

                            HorizontalLayout {
                                spacing: 8px;

                                Text {
                                    width: 40px;
                                    text: frame.id;
                                    font-family: "JetBrains Mono";
                                    font-size: 12px;
                                    color: Theme.text-primary;
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: root.frame-value(frame);
                                    overflow: elide;
                                    font-size: 12px;
                                    color: frame.kind == FrameKind.text ? Theme.text-primary : Theme.text-secondary;
                                }
                            }

                            HorizontalLayout {
                                padding-left: 48px;

                                Text {
                                    text: root.frame-details(frame);
                                    wrap: word-wrap;
                                    font-size: 11px;
                                    color: Theme.text-tertiary;
                                }
                            }
                        }

                        if root.layout.has-id3v1: Text {
                            wrap: word-wrap;
                            text: @tr("ID3v1 at {}, 128 bytes", root.layout.id3v1-offset);
                            font-size: 12px;
                            color: Theme.text-secondary;
                        }
                    }
                }
            }
        }

        ScrollBar {
            y: 0;
            height: parent.height - root.actions-height;
            x: parent.width - root.scrollbar-size;
            width: root.scrollbar-size;
            content-size: flick.content-height;
            visible-size: flick.height;
            position <=> flick.content-y;
            accessible-label: @tr("Inspector scroll bar");
        }

        // Pinned at the bottom, so the actions never leave the screen.
        Rectangle {
            y: parent.height - root.actions-height;
            height: root.actions-height;

            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.border-subtle;
            }

            HorizontalLayout {
                y: 1px;
                height: parent.height - 1px;
                padding: 14px;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 8px;
                alignment: end;

                Button {
                    text: @tr("Revert");
                    enabled: root.tracks.has-changes && !root.saving;
                    clicked => {
                        root.revert();
                    }
                }

                Button {
                    text: root.saving ? @tr("Saving…") : @tr("Save {n} file" | "Save {n} files" % root.modified-count);
                    primary: true;
                    enabled: root.modified-count > 0 && !root.saving;
                    clicked => {
                        root.save();
                    }
                }
            }
        }

        // Over the fields that follow, and above the field when there is no room under it.
        if genre-field.suggesting: SuggestionList {
            property <length> field-y: genre-field.absolute-position.y - parent.absolute-position.y;

            x: genre-field.absolute-position.x - parent.absolute-position.x;
            y: self.field-y + genre-field.height + 2px + self.height <= parent.height - root.actions-height ? self.field-y + genre-field.height + 2px : self.field-y - 2px - self.height;
            width: genre-field.width;
            items: genre-field.suggestions;
            highlighted: genre-field.highlighted;
            picked(genre) => {
                genre-field.pick(genre);
            }
        }
    }

    if root.state == InspectorState.unreadable: VerticalLayout {
        alignment: start;
        padding: 16px;
        spacing: 16px;

        VerticalLayout {
            spacing: 6px;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Image {
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                    source: @image-url("images/circle-alert.svg");
                    colorize: Theme.error;
                }

                Text {
                    vertical-alignment: center;
                    text: @tr("Could not read this file");
                    font-size: 15px;
                    font-weight: 600;
                    color: Theme.text-primary;
                }
            }

            Text {
                wrap: word-wrap;
                text: root.unreadable.path;
                font-family: "JetBrains Mono";
                font-size: 12px;
                color: Theme.text-secondary;
            }
        }

        VerticalLayout {
            spacing: 6px;

            SectionLabel {
                text: @tr("Problem").to-uppercase();
            }

            Text {
                wrap: word-wrap;
                text: root.unreadable.problem == ReadProblem.cannot-open ? @tr("Colophon could not open this file. It may have been moved or deleted, or Colophon may not be allowed to read it.")
                    : root.unreadable.problem == ReadProblem.damaged ? @tr("This file is damaged, or it is not an MP3: Colophon could not make sense of it.")
                    : @tr("Reading this file failed in a way it never should. This is a bug in Colophon, and the file itself may be fine.");
                color: Theme.text-primary;
            }
        }

        VerticalLayout {
            spacing: 6px;

            SectionLabel {
                text: @tr("Details").to-uppercase();
            }

            HorizontalLayout {
                spacing: 8px;

                FieldLabel {
                    text: @tr("File size");
                    size: 12px;
                    padding-left: 0;
                }

                FileValue {
                    text: root.size-text(root.unreadable.size);
                    mono: true;
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            Button {
                text: root.reveal-text;
                clicked => {
                    root.reveal-file();
                }
            }

            Button {
                text: @tr("Copy details");
                clicked => {
                    root.copy-details();
                }
            }
        }
    }
}

import { Theme } from "theme.slint";

// The values a field suggests, shown under it. The field keeps the keyboard: its arrow keys move
// the highlight, and a click here picks a value.
export component SuggestionList inherits Rectangle {
    in property <[string]> items;
    in property <int> highlighted: -1;
    callback picked(string);

    property <length> item-height: 24px;
    property <length> inset: 4px;

    // Scrolls the least that shows the highlighted value.
    changed highlighted => {
        if root.highlighted < 0 {
            return;
        }
        if root.highlighted * root.item-height < -scroller.content-y {
            scroller.content-y = -root.highlighted * root.item-height;
        } else if (root.highlighted + 1) * root.item-height > scroller.height - scroller.content-y {
            scroller.content-y = scroller.height - (root.highlighted + 1) * root.item-height;
        }
    }

    height: min(8, root.items.length) * root.item-height + 2 * root.inset;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.border-subtle;
    background: Theme.surface-2;
    drop-shadow-offset-y: 8px;
    drop-shadow-blur: 24px;
    drop-shadow-color: Theme.shadow-menu;
    accessible-role: list;
    accessible-label: @tr("Suggestions");

    // Takes the clicks between the values, which would otherwise reach what lies below.
    TouchArea { }

    scroller := Flickable {
        x: 1px;
        y: root.inset;
        width: parent.width - 2px;
        height: parent.height - 2 * root.inset;
        content-height: root.items.length * root.item-height;

        for item[index] in root.items: Rectangle {
            y: index * root.item-height;
            height: root.item-height;
            background: index == root.highlighted ? Theme.accent-selection : touch.has-hover ? Theme.surface-3 : transparent;
            accessible-role: list-item;
            accessible-label: item;
            accessible-item-selected: index == root.highlighted;
            accessible-action-default => {
                root.picked(item);
            }

            Text {
                x: 8px;
                width: parent.width - 16px;
                vertical-alignment: center;
                overflow: elide;
                text: item;
                color: Theme.text-primary;
            }

            touch := TouchArea {
                clicked => {
                    root.picked(item);
                }
            }
        }
    }
}

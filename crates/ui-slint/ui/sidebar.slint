import { Theme } from "theme.slint";
import { ScrollBar } from "widgets.slint";

// What the table lists, as the sidebar offers it.
export enum SourceKind { all-tracks, recently-changed, unreadable, folder, album, artist }

// A line of the sidebar: a source, its name, how many tracks it has, and for an album its cover,
// or a colour of its own until the cover is drawn or when it has none.
export struct SidebarItem {
    kind: SourceKind,
    // Its place among the folders, albums or artists.
    index: int,
    label: string,
    count: int,
    swatch: color,
    cover: image,
    has-cover: bool,
}

component SectionTitle inherits Text {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.66px;
    color: Theme.text-tertiary;
}

component SidebarRow inherits Rectangle {
    in property <SidebarItem> item;
    in property <string> label: root.item.label;
    in property <bool> selected;
    in property <bool> mono;
    // The count in the error colour, for files that could not be read.
    in property <bool> alarming;
    in property <bool> with-swatch;
    callback clicked;

    height: 28px;
    border-radius: 4px;
    background: root.selected ? Theme.surface-3 : touch.has-hover ? Theme.surface-2 : transparent;
    animate background { duration: 100ms; }
    accessible-role: list-item;
    accessible-label: root.label;
    accessible-item-selected: root.selected;
    accessible-action-default => {
        root.clicked();
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        if root.with-swatch: Rectangle {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            clip: true;
            background: @linear-gradient(135deg, root.item.swatch, root.item.swatch.darker(40%));

            if root.item.has-cover: Image {
                width: 100%;
                height: 100%;
                source: root.item.cover;
                image-fit: cover;
            }
        }

        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
            text: root.label;
            font-family: root.mono ? "JetBrains Mono" : "Inter";
            font-size: root.mono ? 12px : 13px;
            color: root.selected ? Theme.text-primary : Theme.text-secondary;
        }

        Text {
            vertical-alignment: center;
            text: root.item.count;
            font-size: 12px;
            color: root.alarming && root.item.count > 0 ? Theme.error : Theme.text-tertiary;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// The sources of the table: the library as a whole, its folders, albums and artists.
export component Sidebar inherits Rectangle {
    in property <[SidebarItem]> library;
    in property <[SidebarItem]> folders;
    in property <[SidebarItem]> albums;
    // The first albums, which show until a click shows them all.
    in property <[SidebarItem]> first-albums;
    in property <[SidebarItem]> artists;
    // The source the table lists.
    in property <SourceKind> shown-kind;
    in property <int> shown-index;
    callback show(SourceKind, int);

    property <bool> every-album;
    property <bool> artists-open;

    pure function is-shown(item: SidebarItem) -> bool {
        return item.kind == root.shown-kind && (item.index == root.shown-index || item.kind == SourceKind.all-tracks || item.kind == SourceKind.recently-changed || item.kind == SourceKind.unreadable);
    }

    background: Theme.surface-0;
    accessible-role: navigation;
    accessible-label: @tr("Sidebar");

    flick := Flickable {
        content-height: column.preferred-height;

        column := VerticalLayout {
            width: flick.width;
            alignment: start;
            padding: 10px;
            spacing: 2px;

            SectionTitle {
                text: @tr("Library").to-uppercase();
                height: 26px;
                vertical-alignment: center;
            }

            for item in root.library: SidebarRow {
                item: item;
                label: item.kind == SourceKind.all-tracks ? @tr("All tracks") : item.kind == SourceKind.recently-changed ? @tr("Recently changed") : @tr("Unreadable files");
                selected: root.is-shown(item);
                alarming: item.kind == SourceKind.unreadable;
                clicked => {
                    root.show(item.kind, item.index);
                }
            }

            if root.folders.length > 0: SectionTitle {
                text: @tr("Folders").to-uppercase();
                height: 34px;
                vertical-alignment: bottom;
            }

            for item in root.folders: SidebarRow {
                item: item;
                mono: true;
                selected: root.is-shown(item);
                clicked => {
                    root.show(item.kind, item.index);
                }
            }

            if root.albums.length > 0: SectionTitle {
                text: @tr("Albums").to-uppercase();
                height: 34px;
                vertical-alignment: bottom;
            }

            for item in root.every-album ? root.albums : root.first-albums: SidebarRow {
                item: item;
                with-swatch: true;
                selected: root.is-shown(item);
                clicked => {
                    root.show(item.kind, item.index);
                }
            }

            if !root.every-album && root.albums.length > root.first-albums.length: Rectangle {
                height: 28px;
                accessible-role: button;
                accessible-label: more.text;
                accessible-action-default => {
                    root.every-album = true;
                }

                more := Text {
                    x: 8px;
                    vertical-alignment: center;
                    text: @tr("{n} more album" | "{n} more albums" % (root.albums.length - root.first-albums.length));
                    font-size: 12px;
                    color: Theme.text-tertiary;
                }

                TouchArea {
                    clicked => {
                        root.every-album = true;
                    }
                }
            }

            if root.artists.length > 0: Rectangle {
                height: 34px;
                accessible-role: button;
                accessible-label: @tr("Artists");
                accessible-expandable: true;
                accessible-expanded: root.artists-open;
                accessible-action-default => {
                    root.artists-open = !root.artists-open;
                }

                HorizontalLayout {
                    alignment: start;
                    spacing: 4px;
                    padding-top: 8px;

                    Image {
                        width: 12px;
                        source: @image-url("images/chevron-down.svg");
                        colorize: Theme.text-tertiary;
                        transform-rotation: root.artists-open ? 0deg : -90deg;
                        animate transform-rotation { duration: 100ms; }
                    }

                    artists-title := SectionTitle {
                        vertical-alignment: center;
                        text: @tr("Artists").to-uppercase();
                    }
                }

                TouchArea {
                    clicked => {
                        root.artists-open = !root.artists-open;
                    }
                }
            }

            if root.artists-open: VerticalLayout {
                spacing: 2px;

                for item in root.artists: SidebarRow {
                    item: item;
                    selected: root.is-shown(item);
                    clicked => {
                        root.show(item.kind, item.index);
                    }
                }
            }
        }
    }

    ScrollBar {
        x: parent.width - 10px;
        width: 10px;
        content-size: flick.content-height;
        visible-size: flick.height;
        position <=> flick.content-y;
        accessible-label: @tr("Sidebar scroll bar");
    }
}

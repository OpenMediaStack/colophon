import { Theme } from "theme.slint";

// The toolbar's save button, in the accent colour, which says how many files it saves.
export component SaveButton inherits Rectangle {
    in property <int> count;
    in property <bool> saving;
    callback clicked;

    property <bool> enabled: root.count > 0 && !root.saving;

    height: 28px;
    width: content.preferred-width;
    border-radius: 4px;
    background: !root.enabled ? Theme.surface-3 : touch.has-hover ? Theme.accent-hover : Theme.accent;
    animate background { duration: 100ms; }
    accessible-role: button;
    accessible-label: label.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    content := HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 6px;

        Image {
            width: 16px;
            y: (parent.height - self.height) / 2;
            source: @image-url("images/save.svg");
            colorize: root.enabled ? Theme.on-accent : Theme.text-disabled;
        }

        label := Text {
            vertical-alignment: center;
            text: root.saving ? @tr("Saving…") : root.count == 0 ? @tr("Save") : @tr("Save {n} file" | "Save {n} files" % root.count);
            font-weight: 500;
            color: root.enabled ? Theme.on-accent : Theme.text-disabled;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// Narrows the table to the tracks whose title, artist, album or file name hold the text typed.
// Escape empties it.
export component FilterField inherits Rectangle {
    // How the shortcut that reaches the field is written: ⌘F or Ctrl+F.
    in property <string> shortcut;
    callback edited(string);

    public function focus-field() {
        input.focus();
        input.select-all();
    }

    function clear() {
        input.text = "";
        root.edited("");
    }

    height: 28px;
    border-radius: 4px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.focus-ring : Theme.border-subtle;
    background: Theme.surface-1;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 6px;

        Image {
            width: 14px;
            y: (parent.height - self.height) / 2;
            source: @image-url("images/search.svg");
            colorize: Theme.text-tertiary;
        }

        Rectangle {
            horizontal-stretch: 1;

            if input.text == "": Text {
                width: 100%;
                vertical-alignment: center;
                overflow: elide;
                text: @tr("Filter by title, artist, album");
                color: Theme.text-tertiary;
                accessible-role: none;
            }

            input := TextInput {
                vertical-alignment: center;
                single-line: true;
                color: Theme.text-primary;
                selection-background-color: Theme.accent-selection;
                selection-foreground-color: Theme.text-primary;
                accessible-label: @tr("Filter");
                edited => {
                    root.edited(self.text);
                }
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        root.clear();
                        self.clear-focus();
                        return accept;
                    }
                    return reject;
                }
            }
        }

        if input.text == "": Text {
            vertical-alignment: center;
            text: root.shortcut;
            font-family: "JetBrains Mono";
            font-size: 11px;
            color: Theme.text-tertiary;
        }

        if input.text != "": Rectangle {
            width: 18px;
            accessible-role: button;
            accessible-label: @tr("Clear the filter");
            accessible-action-default => {
                root.clear();
            }

            Image {
                width: 12px;
                source: @image-url("images/x.svg");
                colorize: Theme.text-tertiary;
            }

            TouchArea {
                clicked => {
                    root.clear();
                }
            }
        }
    }
}

import { Theme } from "theme.slint";

// A placeholder for a part of the window that is not built yet.
export component Region inherits Rectangle {
    in property <string> label;

    Text {
        text: root.label;
        font-size: 12px;
        color: Theme.text-tertiary;
    }
}

// A square toolbar button with an icon. As a toggle, it looks pressed while checked.
export component ToolbarButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> checkable;
    in property <bool> checked;
    in property <length> icon-size: 16px;
    callback clicked;

    width: 28px;
    height: 28px;
    border-radius: 4px;
    background: root.checked || touch.has-hover ? Theme.surface-3 : transparent;
    animate background { duration: 100ms; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: root.checkable;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.clicked();
    }

    Image {
        width: root.icon-size;
        height: root.icon-size;
        source: root.icon;
        colorize: root.checked ? Theme.text-primary : Theme.text-secondary;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// The main action of a screen, in the accent colour, with its shortcut.
export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <string> shortcut;
    callback clicked;

    height: 32px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.accent-hover : Theme.accent;
    animate background { duration: 100ms; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;

        Text {
            vertical-alignment: center;
            text: root.text;
            font-weight: 500;
            color: Theme.on-accent;
        }

        if root.shortcut != "": Text {
            vertical-alignment: center;
            text: root.shortcut;
            font-size: 12px;
            color: Theme.on-accent;
            opacity: 0.75;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A small bordered button for secondary actions in tight places, such as the status bar.
export component SmallButton inherits Rectangle {
    in property <string> text;
    callback clicked;

    height: 18px;
    border-radius: 3px;
    border-width: 1px;
    border-color: Theme.border-strong;
    background: touch.has-hover ? Theme.surface-3 : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;

        Text {
            vertical-alignment: center;
            text: root.text;
            font-size: 11px;
            color: Theme.text-primary;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A list that creates only the rows in view. Slint virtualises a `for` placed directly in an element
// named ListView with these properties. Dragging inside it selects, as in a desktop app, so it does not pan.
export component ListView inherits Flickable {
    out property <length> visible-width: self.width;
    out property <length> visible-height: self.height;
    mouse-drag-pan-enabled: false;
}

// A thin scroll bar drawn over the edge of the content it scrolls. `position` is the content's offset,
// zero or negative as in a Flickable.
export component ScrollBar inherits Rectangle {
    in property <bool> horizontal;
    in property <length> content-size;
    in property <length> visible-size;
    in-out property <length> position;

    property <length> track-length: root.horizontal ? root.width : root.height;
    property <length> max-scroll: max(0px, root.content-size - root.visible-size);
    property <length> thumb-length: root.content-size > 0px ? max(24px, root.visible-size / root.content-size * root.track-length) : root.track-length;
    property <length> travel: max(1px, root.track-length - root.thumb-length);
    property <length> thumb-offset: root.max-scroll > 0px ? -root.position / root.max-scroll * root.travel : 0px;
    property <length> pressed-position;

    visible: root.max-scroll > 0px;
    accessible-role: slider;

    function clamped(position: length) -> length {
        return max(-root.max-scroll, min(0px, position));
    }

    function center-thumb-on(pointer: length) {
        root.position = root.clamped(-(pointer - root.thumb-length / 2) / root.travel * root.max-scroll);
    }

    Rectangle {
        x: root.horizontal ? root.thumb-offset : 2px;
        y: root.horizontal ? 2px : root.thumb-offset;
        width: root.horizontal ? root.thumb-length : root.width - 4px;
        height: root.horizontal ? root.height - 4px : root.thumb-length;
        border-radius: 3px;
        background: touch.pressed || touch.has-hover ? Theme.text-tertiary : Theme.border-strong;
        animate background { duration: 120ms; }
    }

    touch := TouchArea {
        property <length> pointer: root.horizontal ? self.mouse-x : self.mouse-y;
        property <length> pressed-pointer: root.horizontal ? self.pressed-x : self.pressed-y;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                if self.pointer < root.thumb-offset || self.pointer > root.thumb-offset + root.thumb-length {
                    root.center-thumb-on(self.pointer);
                }
                root.pressed-position = root.position;
            }
        }

        moved => {
            if self.pressed {
                root.position = root.clamped(root.pressed-position - (self.pointer - self.pressed-pointer) / root.travel * root.max-scroll);
            }
        }
    }
}

// A button of the inspector's actions: the main one in the accent colour, the others bordered.
export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked;

    height: 28px;
    border-radius: 4px;
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.border-strong;
    background: !root.primary ? (touch.has-hover && root.enabled ? Theme.surface-3 : transparent) : touch.has-hover && root.enabled ? Theme.accent-hover : Theme.accent;
    opacity: root.enabled ? 1 : 0.5;
    animate background { duration: 100ms; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;

        Text {
            vertical-alignment: center;
            horizontal-alignment: center;
            text: root.text;
            font-weight: root.primary ? 500 : 400;
            color: root.primary ? Theme.on-accent : Theme.text-primary;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// One choice of a Segmented control. Version numbers line up in JetBrains Mono.
export struct Segment {
    label: string,
    mono: bool,
}

// A row of choices, one of them selected; none while the selection mixes several.
export component Segmented inherits Rectangle {
    in property <[Segment]> segments;
    in property <int> selected: -1;
    in property <string> label;
    callback chosen(int);

    height: 28px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border-strong;
    background: Theme.surface-2;
    accessible-role: radio-group;
    accessible-label: root.label;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;

        for segment[index] in root.segments: Rectangle {
            // Equal shares of the width, whatever the length of each label.
            min-width: 0px;
            preferred-width: 0px;
            horizontal-stretch: 1;
            border-radius: 3px;
            background: index == root.selected ? Theme.surface-3 : touch.has-hover ? Theme.border-subtle : transparent;
            animate background { duration: 100ms; }
            accessible-role: radio-button;
            accessible-label: segment.label;
            accessible-checked: index == root.selected;
            accessible-action-default => {
                root.chosen(index);
            }

            Text {
                horizontal-alignment: center;
                vertical-alignment: center;
                text: segment.label;
                font-family: segment.mono ? "JetBrains Mono" : "Inter";
                font-size: segment.mono ? 12px : 13px;
                font-weight: index == root.selected ? 500 : 400;
                color: index == root.selected ? Theme.text-primary : Theme.text-secondary;
            }

            touch := TouchArea {
                clicked => {
                    root.chosen(index);
                }
            }
        }
    }
}

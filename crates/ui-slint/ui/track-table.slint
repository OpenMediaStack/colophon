import { Theme } from "theme.slint";
import { ListView, ScrollBar, ToolbarButton } from "widgets.slint";

export enum TrackStatus { normal, unreadable }

export enum TrackColumn { title, artist, album, year, genre, time, bitrate, tags, file, folder }

// One file of the opened folder, as the table shows it.
export struct TrackRow {
    status: TrackStatus,
    number: string,
    title: string,
    // The file has no title tag: the title shown is its file name.
    untitled: bool,
    artist: string,
    album: string,
    year: string,
    genre: string,
    time: string,
    bitrate: string,
    tags: string,
    file: string,
    folder: string,
    selected: bool,
    // The track the arrow keys move from.
    focused: bool,
}

// The columns the table shows besides status, number and title, which are always there.
export struct TrackColumns {
    artist: bool,
    album: bool,
    year: bool,
    genre: bool,
    time: bool,
    bitrate: bool,
    tags: bool,
    file: bool,
    folder: bool,
}

// The width of every column but status and number.
export struct TrackColumnWidths {
    title: length,
    artist: length,
    album: length,
    year: length,
    genre: length,
    time: length,
    bitrate: length,
    tags: length,
    file: length,
    folder: length,
}

component Cell inherits Rectangle {
    in property <string> text;
    in property <color> text-color: Theme.text-secondary;
    in property <bool> mono;
    in property <TextHorizontalAlignment> text-alignment: left;
    in property <length> size: root.mono ? 12px : 13px;
    in property <int> weight: 400;
    // The line at the right edge, where the column can be resized.
    in property <color> separator: Theme.border-row;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;

        Text {
            vertical-alignment: center;
            horizontal-alignment: root.text-alignment;
            overflow: elide;
            text: root.text;
            font-family: root.mono ? "JetBrains Mono" : "Inter";
            font-size: root.size;
            font-weight: root.weight;
            color: root.text-color;
        }
    }

    Rectangle {
        x: root.width - 1px;
        width: 1px;
        background: root.separator;
    }
}

// Numbers line up in JetBrains Mono, aligned right.
component NumberCell inherits Cell {
    mono: true;
    text-alignment: right;
}

// A column's name. Dragging its last pixels resizes the column, and a double click there fits the
// column to its longest value.
component HeaderCell inherits Cell {
    in property <bool> resizable: true;
    callback resized(length);
    callback fitted;

    size: 12px;
    weight: 500;
    separator: root.resizable ? Theme.border-subtle : transparent;

    if root.resizable: TouchArea {
        // The pointer and the width when the drag started. The handle moves with the column's edge, so
        // the pointer is followed in window coordinates.
        property <length> start-pointer;
        property <length> start-width;

        x: root.width - 6px;
        width: 6px;
        mouse-cursor: col-resize;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                self.start-pointer = self.absolute-position.x + self.pressed-x;
                self.start-width = root.width;
            }
        }
        moved => {
            if self.pressed {
                root.resized(self.start-width + self.absolute-position.x + self.mouse-x - self.start-pointer);
            }
        }
        double-clicked => {
            root.fitted();
        }
    }
}

// Measures a text in the font of the cells, without showing it to anyone.
component Probe inherits Text {
    visible: false;
    accessible-role: none;
    accessible-label: "";
    font-family: "Inter";
    font-size: 13px;
}

component NumberProbe inherits Probe {
    font-family: "JetBrains Mono";
    font-size: 12px;
}

component HeaderProbe inherits Probe {
    font-size: 12px;
    font-weight: 500;
}

component RowDivider inherits Rectangle {
    height: 1px;
    background: Theme.border-row;
}

component TableRow inherits Rectangle {
    in property <TrackRow> track;
    in property <length> status-width;
    in property <length> number-width;
    in property <TrackColumnWidths> widths;
    // The table has the keyboard focus, which outlines the focused track.
    in property <bool> table-focused;
    // A press of the left button, with Command (Ctrl elsewhere) or Shift held.
    callback pressed(bool, bool);

    height: 26px;
    background: root.track.selected ? Theme.accent-selection : touch.has-hover ? Theme.surface-3 : transparent;
    border-width: root.track.focused && root.table-focused ? 1px : 0px;
    border-color: Theme.focus-ring;

    HorizontalLayout {
        alignment: start;

        Rectangle {
            width: root.status-width;

            if root.track.status == TrackStatus.unreadable: Image {
                width: 14px;
                height: 14px;
                source: @image-url("images/circle-alert.svg");
                colorize: Theme.error;
                accessible-role: image;
                accessible-label: @tr("Unreadable");
            }
        }

        NumberCell {
            width: root.number-width;
            text: root.track.number;
            text-color: Theme.text-tertiary;
            separator: transparent;
        }

        Cell {
            width: root.widths.title;
            text: root.track.title;
            text-color: root.track.status == TrackStatus.unreadable ? Theme.error : root.track.untitled ? Theme.text-tertiary : Theme.text-primary;
            weight: root.track.selected ? 500 : 400;
        }

        if root.widths.artist > 0: Cell {
            width: root.widths.artist;
            text: root.track.artist;
        }
        if root.widths.album > 0: Cell {
            width: root.widths.album;
            text: root.track.album;
        }
        if root.widths.year > 0: NumberCell {
            width: root.widths.year;
            text: root.track.year;
        }
        if root.widths.genre > 0: Cell {
            width: root.widths.genre;
            text: root.track.genre;
        }
        if root.widths.time > 0: NumberCell {
            width: root.widths.time;
            text: root.track.time;
        }
        if root.widths.bitrate > 0: NumberCell {
            width: root.widths.bitrate;
            text: root.track.bitrate;
        }
        if root.widths.tags > 0: Cell {
            width: root.widths.tags;
            text: root.track.tags;
            mono: true;
        }
        if root.widths.file > 0: Cell {
            width: root.widths.file;
            text: root.track.file;
        }
        if root.widths.folder > 0: Cell {
            width: root.widths.folder;
            text: root.track.folder;
        }
    }

    RowDivider {
        y: root.height - 1px;
    }

    // Slint reports the Command key of macOS as control, so one test covers every platform.
    touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.pressed(event.modifiers.control, event.modifiers.shift);
            }
        }
    }
}

// The tracks of the opened folder, in a list that scrolls sideways when its columns do not fit.
export component TrackTable inherits Rectangle {
    in property <[TrackRow]> rows;
    in property <TrackColumns> columns;
    // Until the user resizes a column, the table shares its width between the columns. From then
    // on, each column keeps the width the user gave it and the table scrolls sideways if it must.
    in property <bool> sized;
    in property <TrackColumnWidths> sized-widths;
    // The longest value of each column, measured to fit a column to its content.
    in property <TrackRow> longest;
    // The row the arrow keys move from, -1 for none. The table scrolls to keep it in view.
    in property <int> focused-row: -1;
    callback track-pressed(int, bool, bool);
    callback select-all;
    // An arrow key: up or down, and whether Shift extends the selection.
    callback step-selection(bool, bool);
    callback toggle-column(TrackColumn);
    callback reset-columns;
    callback columns-resized(TrackColumnWidths);

    property <length> header-height: 28px;
    property <length> row-height: 26px;
    property <length> scrollbar-size: 10px;
    property <length> status-width: 24px;
    property <length> number-width: 36px;
    // Room at the right end of the rows for the vertical scroll bar and the columns button.
    property <length> end-width: 32px;
    property <length> narrowest-width: 40px;
    property <length> widest-fit: 600px;
    // Every column has a minimum width. The text columns share the room left by these weights, as
    // in the mockup, and the others keep their width.
    property <TrackColumnWidths> natural-widths: {
        title: 200px,
        artist: 140px,
        album: 160px,
        year: 56px,
        genre: 96px,
        time: 56px,
        bitrate: 72px,
        tags: 132px,
        file: 180px,
        folder: 180px,
    };
    property <TrackColumnWidths> min-widths: {
        title: root.natural-widths.title,
        artist: root.columns.artist ? root.natural-widths.artist : 0px,
        album: root.columns.album ? root.natural-widths.album : 0px,
        year: root.columns.year ? root.natural-widths.year : 0px,
        genre: root.columns.genre ? root.natural-widths.genre : 0px,
        time: root.columns.time ? root.natural-widths.time : 0px,
        bitrate: root.columns.bitrate ? root.natural-widths.bitrate : 0px,
        tags: root.columns.tags ? root.natural-widths.tags : 0px,
        file: root.columns.file ? root.natural-widths.file : 0px,
        folder: root.columns.folder ? root.natural-widths.folder : 0px,
    };
    property <float> title-weight: 1.6;
    property <float> artist-weight: root.columns.artist ? 1.1 : 0;
    property <float> album-weight: root.columns.album ? 1.2 : 0;
    property <float> file-weight: root.columns.file ? 1 : 0;
    property <float> folder-weight: root.columns.folder ? 1 : 0;
    property <float> total-weight: root.title-weight + root.artist-weight + root.album-weight + root.file-weight + root.folder-weight;
    property <length> columns-min-width: root.status-width + root.number-width + root.min-widths.title + root.min-widths.artist + root.min-widths.album + root.min-widths.year + root.min-widths.genre + root.min-widths.time + root.min-widths.bitrate + root.min-widths.tags + root.min-widths.file + root.min-widths.folder + root.end-width;
    property <length> spare-width: max(0px, root.width - root.columns-min-width) / root.total-weight;
    property <TrackColumnWidths> shared-widths: {
        title: root.min-widths.title + root.spare-width * root.title-weight,
        artist: root.min-widths.artist + root.spare-width * root.artist-weight,
        album: root.min-widths.album + root.spare-width * root.album-weight,
        year: root.min-widths.year,
        genre: root.min-widths.genre,
        time: root.min-widths.time,
        bitrate: root.min-widths.bitrate,
        tags: root.min-widths.tags,
        file: root.min-widths.file + root.spare-width * root.file-weight,
        folder: root.min-widths.folder + root.spare-width * root.folder-weight,
    };
    property <TrackColumnWidths> widths: root.sized ? {
        title: root.sized-widths.title,
        artist: root.columns.artist ? root.sized-widths.artist : 0px,
        album: root.columns.album ? root.sized-widths.album : 0px,
        year: root.columns.year ? root.sized-widths.year : 0px,
        genre: root.columns.genre ? root.sized-widths.genre : 0px,
        time: root.columns.time ? root.sized-widths.time : 0px,
        bitrate: root.columns.bitrate ? root.sized-widths.bitrate : 0px,
        tags: root.columns.tags ? root.sized-widths.tags : 0px,
        file: root.columns.file ? root.sized-widths.file : 0px,
        folder: root.columns.folder ? root.sized-widths.folder : 0px,
    } : root.shared-widths;
    // The widths as they stand, a hidden column keeping its natural width for when it shows again.
    property <TrackColumnWidths> current-widths: {
        title: root.widths.title,
        artist: root.columns.artist ? root.widths.artist : root.natural-widths.artist,
        album: root.columns.album ? root.widths.album : root.natural-widths.album,
        year: root.columns.year ? root.widths.year : root.natural-widths.year,
        genre: root.columns.genre ? root.widths.genre : root.natural-widths.genre,
        time: root.columns.time ? root.widths.time : root.natural-widths.time,
        bitrate: root.columns.bitrate ? root.widths.bitrate : root.natural-widths.bitrate,
        tags: root.columns.tags ? root.widths.tags : root.natural-widths.tags,
        file: root.columns.file ? root.widths.file : root.natural-widths.file,
        folder: root.columns.folder ? root.widths.folder : root.natural-widths.folder,
    };
    property <length> columns-width: root.status-width + root.number-width + root.widths.title + root.widths.artist + root.widths.album + root.widths.year + root.widths.genre + root.widths.time + root.widths.bitrate + root.widths.tags + root.widths.file + root.widths.folder + root.end-width;
    property <bool> scrolls-sideways: root.sized ? root.columns-width > root.width : root.width < root.columns-min-width;
    property <length> content-width: root.scrolls-sideways ? root.columns-width : root.width;
    property <length> list-height: root.height - root.header-height - (root.scrolls-sideways ? root.scrollbar-size : 0px);
    property <length> rows-height: root.rows.length * root.row-height;
    property <length> scroll-x;
    property <length> scroll-y;

    // Keeps the lists in bounds when the window grows or a new folder empties the table.
    function clamp-scroll() {
        root.scroll-x = max(root.scroll-x, min(0px, root.width - root.content-width));
        root.scroll-y = max(root.scroll-y, min(0px, root.list-height - root.rows-height));
    }

    // Scrolls the least that shows the whole row.
    function reveal(row: int) {
        if row < 0 {
            return;
        }
        if row * root.row-height < -root.scroll-y {
            root.scroll-y = -row * root.row-height;
        } else if (row + 1) * root.row-height > root.list-height - root.scroll-y {
            root.scroll-y = root.list-height - (row + 1) * root.row-height;
        }
    }

    changed focused-row => {
        root.reveal(root.focused-row);
    }

    init => {
        keys.focus();
    }

    function resize(column: TrackColumn, width: length) {
        root.columns-resized(root.with-width(column, max(root.narrowest-width, width)));
    }

    function with-width(column: TrackColumn, width: length) -> TrackColumnWidths {
        return {
            title: column == TrackColumn.title ? width : root.current-widths.title,
            artist: column == TrackColumn.artist ? width : root.current-widths.artist,
            album: column == TrackColumn.album ? width : root.current-widths.album,
            year: column == TrackColumn.year ? width : root.current-widths.year,
            genre: column == TrackColumn.genre ? width : root.current-widths.genre,
            time: column == TrackColumn.time ? width : root.current-widths.time,
            bitrate: column == TrackColumn.bitrate ? width : root.current-widths.bitrate,
            tags: column == TrackColumn.tags ? width : root.current-widths.tags,
            file: column == TrackColumn.file ? width : root.current-widths.file,
            folder: column == TrackColumn.folder ? width : root.current-widths.folder,
        };
    }

    // The width that shows a column's name and its longest value whole: both paddings and the separator.
    function fit-width(value: length, name: length) -> length {
        return min(root.widest-fit, max(value, name) + 17px);
    }

    function fit(column: TrackColumn) {
        if column == TrackColumn.title {
            root.resize(column, root.fit-width(title-probe.preferred-width, title-name.preferred-width));
        } else if column == TrackColumn.artist {
            root.resize(column, root.fit-width(artist-probe.preferred-width, artist-name.preferred-width));
        } else if column == TrackColumn.album {
            root.resize(column, root.fit-width(album-probe.preferred-width, album-name.preferred-width));
        } else if column == TrackColumn.year {
            root.resize(column, root.fit-width(year-probe.preferred-width, year-name.preferred-width));
        } else if column == TrackColumn.genre {
            root.resize(column, root.fit-width(genre-probe.preferred-width, genre-name.preferred-width));
        } else if column == TrackColumn.time {
            root.resize(column, root.fit-width(time-probe.preferred-width, time-name.preferred-width));
        } else if column == TrackColumn.bitrate {
            root.resize(column, root.fit-width(bitrate-probe.preferred-width, bitrate-name.preferred-width));
        } else if column == TrackColumn.tags {
            root.resize(column, root.fit-width(tags-probe.preferred-width, tags-name.preferred-width));
        } else if column == TrackColumn.file {
            root.resize(column, root.fit-width(file-probe.preferred-width, file-name.preferred-width));
        } else if column == TrackColumn.folder {
            root.resize(column, root.fit-width(folder-probe.preferred-width, folder-name.preferred-width));
        }
    }

    changed width => {
        root.clamp-scroll();
    }
    changed content-width => {
        root.clamp-scroll();
    }
    changed list-height => {
        root.clamp-scroll();
    }
    changed rows-height => {
        root.clamp-scroll();
    }

    background: Theme.surface-1;

    keys := FocusScope {
        width: 0;
        height: 0;

        key-pressed(event) => {
            if event.text == Key.UpArrow || event.text == Key.DownArrow {
                root.step-selection(event.text == Key.UpArrow, event.modifiers.shift);
                return accept;
            }
            if event.modifiers.control && (event.text == "a" || event.text == "A") {
                root.select-all();
                return accept;
            }
            return reject;
        }
    }

    // A container of no size, so that the long texts measured inside never stretch the table.
    Rectangle {
        width: 0;
        height: 0;
        clip: true;

        title-probe := Probe {
            text: root.longest.title;
        }
        artist-probe := Probe {
            text: root.longest.artist;
        }
        album-probe := Probe {
            text: root.longest.album;
        }
        year-probe := NumberProbe {
            text: root.longest.year;
        }
        genre-probe := Probe {
            text: root.longest.genre;
        }
        time-probe := NumberProbe {
            text: root.longest.time;
        }
        bitrate-probe := NumberProbe {
            text: root.longest.bitrate;
        }
        tags-probe := NumberProbe {
            text: root.longest.tags;
        }
        file-probe := Probe {
            text: root.longest.file;
        }
        folder-probe := Probe {
            text: root.longest.folder;
        }
        title-name := HeaderProbe {
            text: @tr("Title");
        }
        artist-name := HeaderProbe {
            text: @tr("Artist");
        }
        album-name := HeaderProbe {
            text: @tr("Album");
        }
        year-name := HeaderProbe {
            text: @tr("Year");
        }
        genre-name := HeaderProbe {
            text: @tr("Genre");
        }
        time-name := HeaderProbe {
            text: @tr("Time");
        }
        bitrate-name := HeaderProbe {
            text: @tr("Bitrate");
        }
        tags-name := HeaderProbe {
            text: @tr("Tags");
        }
        file-name := HeaderProbe {
            text: @tr("File");
        }
        folder-name := HeaderProbe {
            text: @tr("Folder");
        }
    }

    // A right click on the header, or the button at its right end, opens the column chooser.
    header-menu := ContextMenuArea {
        y: 0;
        height: root.header-height;

        Menu {
            MenuItem {
                title: @tr("Title");
                checkable: true;
                checked: true;
                enabled: false;
            }

            MenuItem {
                title: @tr("Artist");
                checkable: true;
                checked: root.columns.artist;
                activated => {
                    root.toggle-column(TrackColumn.artist);
                }
            }

            MenuItem {
                title: @tr("Album");
                checkable: true;
                checked: root.columns.album;
                activated => {
                    root.toggle-column(TrackColumn.album);
                }
            }

            MenuItem {
                title: @tr("Year");
                checkable: true;
                checked: root.columns.year;
                activated => {
                    root.toggle-column(TrackColumn.year);
                }
            }

            MenuItem {
                title: @tr("Genre");
                checkable: true;
                checked: root.columns.genre;
                activated => {
                    root.toggle-column(TrackColumn.genre);
                }
            }

            MenuItem {
                title: @tr("Time");
                checkable: true;
                checked: root.columns.time;
                activated => {
                    root.toggle-column(TrackColumn.time);
                }
            }

            MenuItem {
                title: @tr("Bitrate");
                checkable: true;
                checked: root.columns.bitrate;
                activated => {
                    root.toggle-column(TrackColumn.bitrate);
                }
            }

            MenuItem {
                title: @tr("Tags");
                checkable: true;
                checked: root.columns.tags;
                activated => {
                    root.toggle-column(TrackColumn.tags);
                }
            }

            MenuItem {
                title: @tr("File");
                checkable: true;
                checked: root.columns.file;
                activated => {
                    root.toggle-column(TrackColumn.file);
                }
            }

            MenuItem {
                title: @tr("Folder");
                checkable: true;
                checked: root.columns.folder;
                activated => {
                    root.toggle-column(TrackColumn.folder);
                }
            }

            MenuSeparator { }

            MenuItem {
                title: @tr("Reset to default columns");
                activated => {
                    root.reset-columns();
                }
            }
        }

        Rectangle {
            background: Theme.surface-2;

            Rectangle {
                clip: true;

                HorizontalLayout {
                    x: root.scroll-x;
                    width: root.content-width;
                    height: parent.height;
                    alignment: start;

                    Rectangle {
                        width: root.status-width;
                    }

                    HeaderCell {
                        width: root.number-width;
                        text: "#";
                        text-alignment: right;
                        resizable: false;
                    }

                    HeaderCell {
                        width: root.widths.title;
                        text: @tr("Title");
                        resized(width) => {
                            root.resize(TrackColumn.title, width);
                        }
                        fitted => {
                            root.fit(TrackColumn.title);
                        }
                    }

                    if root.columns.artist: HeaderCell {
                        width: root.widths.artist;
                        text: @tr("Artist");
                        resized(width) => {
                            root.resize(TrackColumn.artist, width);
                        }
                        fitted => {
                            root.fit(TrackColumn.artist);
                        }
                    }
                    if root.columns.album: HeaderCell {
                        width: root.widths.album;
                        text: @tr("Album");
                        resized(width) => {
                            root.resize(TrackColumn.album, width);
                        }
                        fitted => {
                            root.fit(TrackColumn.album);
                        }
                    }
                    if root.columns.year: HeaderCell {
                        width: root.widths.year;
                        text: @tr("Year");
                        text-alignment: right;
                        resized(width) => {
                            root.resize(TrackColumn.year, width);
                        }
                        fitted => {
                            root.fit(TrackColumn.year);
                        }
                    }
                    if root.columns.genre: HeaderCell {
                        width: root.widths.genre;
                        text: @tr("Genre");
                        resized(width) => {
                            root.resize(TrackColumn.genre, width);
                        }
                        fitted => {
                            root.fit(TrackColumn.genre);
                        }
                    }
                    if root.columns.time: HeaderCell {
                        width: root.widths.time;
                        text: @tr("Time");
                        text-alignment: right;
                        resized(width) => {
                            root.resize(TrackColumn.time, width);
                        }
                        fitted => {
                            root.fit(TrackColumn.time);
                        }
                    }
                    if root.columns.bitrate: HeaderCell {
                        width: root.widths.bitrate;
                        text: @tr("Bitrate");
                        text-alignment: right;
                        resized(width) => {
                            root.resize(TrackColumn.bitrate, width);
                        }
                        fitted => {
                            root.fit(TrackColumn.bitrate);
                        }
                    }
                    if root.columns.tags: HeaderCell {
                        width: root.widths.tags;
                        text: @tr("Tags");
                        resized(width) => {
                            root.resize(TrackColumn.tags, width);
                        }
                        fitted => {
                            root.fit(TrackColumn.tags);
                        }
                    }
                    if root.columns.file: HeaderCell {
                        width: root.widths.file;
                        text: @tr("File");
                        resized(width) => {
                            root.resize(TrackColumn.file, width);
                        }
                        fitted => {
                            root.fit(TrackColumn.file);
                        }
                    }
                    if root.columns.folder: HeaderCell {
                        width: root.widths.folder;
                        text: @tr("Folder");
                        resized(width) => {
                            root.resize(TrackColumn.folder, width);
                        }
                        fitted => {
                            root.fit(TrackColumn.folder);
                        }
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border-subtle;
            }

            Rectangle {
                x: parent.width - root.end-width;
                width: root.end-width;
                height: parent.height - 1px;
                background: Theme.surface-2;

                ToolbarButton {
                    width: 24px;
                    height: 24px;
                    icon: @image-url("images/columns.svg");
                    icon-size: 14px;
                    label: @tr("Choose columns");
                    clicked => {
                        header-menu.show({ x: header-menu.width - root.end-width, y: root.header-height });
                    }
                }
            }
        }
    }

    track-list := ListView {
        x: 0;
        y: root.header-height;
        width: root.width;
        height: root.list-height;
        content-width: root.content-width;
        content-x <=> root.scroll-x;
        content-y <=> root.scroll-y;
        accessible-role: list;
        accessible-label: @tr("Tracks");

        for row[index] in root.rows: TableRow {
            width: root.content-width;
            track: row;
            status-width: root.status-width;
            number-width: root.number-width;
            widths: root.widths;
            table-focused: keys.has-focus;
            pressed(toggle, extend) => {
                keys.focus();
                root.track-pressed(index, toggle, extend);
            }
        }
    }

    vertical-bar := ScrollBar {
        x: root.width - root.scrollbar-size;
        y: root.header-height;
        width: root.scrollbar-size;
        height: root.list-height;
        content-size: root.rows-height;
        visible-size: track-list.visible-height;
        position <=> root.scroll-y;
        accessible-label: @tr("Vertical scroll bar");
    }

    if root.scrolls-sideways: Rectangle {
        x: 0;
        y: root.height - root.scrollbar-size;
        width: root.width;
        height: root.scrollbar-size;

        Rectangle {
            y: 0;
            height: 1px;
            background: Theme.border-row;
        }

        ScrollBar {
            horizontal: true;
            content-size: root.content-width;
            visible-size: track-list.visible-width;
            position <=> root.scroll-x;
            accessible-label: @tr("Horizontal scroll bar");
        }
    }
}

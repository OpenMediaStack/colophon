#: ui/tag-removal.slint:22
msgctxt "ConfirmTagRemoval"
msgid "Remove the ID3v1 tag from {n} file?"
msgid_plural "Remove the ID3v1 tag from {n} files?"
msgstr[0] "Supprimer le tag ID3v1 de {n} fichier ?"
msgstr[1] "Supprimer le tag ID3v1 de {n} fichiers ?"

#: ui/tag-removal.slint:22
msgctxt "ConfirmTagRemoval"
msgid "Remove the ID3v2 tag from {n} file?"
msgid_plural "Remove the ID3v2 tag from {n} files?"
msgstr[0] "Supprimer le tag ID3v2 de {n} fichier ?"
msgstr[1] "Supprimer le tag ID3v2 de {n} fichiers ?"

#: ui/tag-removal.slint:23
msgctxt "ConfirmTagRemoval"
msgid "Some old players and car stereos only read ID3v1. After saving, these files will no longer have one."
msgstr "Certains vieux lecteurs et autoradios ne lisent que l’ID3v1. Une fois enregistrés, ces fichiers n’en auront plus."

#: ui/tag-removal.slint:23
msgctxt "ConfirmTagRemoval"
msgid "ID3v2 holds what ID3v1 cannot: the album artist, the track total, long titles and comments, the cover. After saving, these files will lose them."
msgstr "L’ID3v2 contient ce que l’ID3v1 ne peut pas garder : l’artiste de l’album, le nombre de pistes, les titres et commentaires longs, la pochette. Une fois enregistrés, ces fichiers les perdront."


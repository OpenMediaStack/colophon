msgid "{0}, {1} and {2} have changes that are not saved yet."
msgstr "{0}, {1} et {2} ont des modifications qui ne sont pas encore enregistrées."

#: ui/unsaved-changes.slint:13
msgctxt "UnsavedChanges"
msgid "{0}, {1} and {2} other files have changes that are not saved yet."
msgstr "{0}, {1} et {2} autres fichiers ont des modifications qui ne sont pas encore enregistrées."

#: ui/unsaved-changes.slint:16
msgctxt "UnsavedChanges"
msgid "Save changes to {n} file before quitting?"
msgid_plural "Save changes to {n} files before quitting?"
msgstr[0] "Enregistrer les modifications de {n} fichier avant de quitter ?"
msgstr[1] "Enregistrer les modifications de {n} fichiers avant de quitter ?"

#: ui/unsaved-changes.slint:17
msgctxt "UnsavedChanges"
msgid "Quitting without saving discards them."
msgstr "Si vous quittez sans enregistrer, elles seront perdues."

#: ui/unsaved-changes.slint:18
msgctxt "UnsavedChanges"
msgid "Save {n} file"
msgid_plural "Save {n} files"
msgstr[0] "Enregistrer {n} fichier"
msgstr[1] "Enregistrer {n} fichiers"

#: ui/unsaved-changes.slint:19
msgctxt "UnsavedChanges"
msgid "Don’t Save"
msgstr "Ne pas enregistrer"
